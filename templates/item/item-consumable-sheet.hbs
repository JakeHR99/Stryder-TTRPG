<form class="{{cssClass}} fantasy-item-sheet" autocomplete="off">
  <div class="oi-frame sty-ornate">
    {{> "systems/stryder/templates/item/parts/ornate-header.hbs" typeLabel="Consumable Item"}}

    {{!-- Extra header: Rarity, Nature, Sell Price --}}
    <div class="oi-extra-header">
      <div class="grid grid-3col">
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Rarity</label>
          <select class="secondary-input" name="system.rarity">
            {{#select system.rarity}}
            <option value="common">Common</option>
            <option value="uncommon">Uncommon</option>
            <option value="rare">Rare</option>
            <option value="mythic">Legendary</option>
            <option value="one of a kind">One of a Kind</option>
            {{/select}}
          </select>
        </div>
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Nature</label>
          <select class="secondary-input" name="system.nature">
            {{#select system.nature}}
            <option value="enchanted">Enchanted</option>
            <option value="magytech">Magytech</option>
            <option value="other">Other</option>
            {{/select}}
          </select>
        </div>
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Sell Price (Grail)</label>
          <input class="tertiary-input" type="text" name="system.sell_price" value="{{system.sell_price}}" placeholder="0" data-dtype="Number" />
        </div>
      </div>
    </div>

    {{!-- Content Area --}}
    <div class="oi-content-area">
      <div class="editor-container">
        <div class="editor-header">
          <i class="fas fa-flask"></i> Item Description
        </div>
        {{editor system.description target="system.description" rollData=rollData button=true owner=owner editable=editable}}
      </div>

      {{!-- Charges --}}
      <div class="resource charges-section">
        <div class="section-header">
          <div class="header-decoration left"></div>
          <label for="system.charges" class="resource-label">Charges</label>
          <div class="header-decoration right"></div>
        </div>
        <div class="section-content">
          <div class="oi-charges-display">
            <input type="text" name="system.charges.value" value="{{system.charges.value}}" data-dtype="Number" class="fantasy-field"/>
            <span class="oi-charges-sep"> / </span>
            <input type="text" name="system.charges.max" value="{{system.charges.max}}" data-dtype="Number" class="fantasy-field"/>
          </div>
        </div>
      </div>

      {{!-- Is Elixir? toggle --}}
      <div class="consumable-elixir-toggle">
        <label class="resource-label secondary-input">Is Elixir?</label>
        <input type="checkbox" name="system.is_elixir" {{#if system.is_elixir}}checked{{/if}} />
      </div>

      {{!-- Elixir Effects — only shown when Is Elixir is checked --}}
      {{#if system.is_elixir}}
      <div class="resource effect-section">
        <div class="section-header">
          <div class="header-decoration left"></div>
          <label class="resource-label">Elixir Effect</label>
          <div class="header-decoration right"></div>
        </div>
        <div class="section-content">
          <div class="resource grid grid-3col">
            <div class="dropdown-field">
              <label class="resource-label secondary-input">Effect Type</label>
              <select class="secondary-input" name="system.effect_type">
                {{#select system.effect_type}}
                <option value="none">None</option>
                <optgroup label="Percentage">
                  <option value="heal_hp">Heal HP (%)</option>
                  <option value="heal_mana">Restore Mana (%)</option>
                  <option value="heal_stamina">Restore Stamina (%)</option>
                </optgroup>
                <optgroup label="Flat Value">
                  <option value="heal_hp_flat">Heal HP (Flat)</option>
                  <option value="heal_mana_flat">Restore Mana (Flat)</option>
                  <option value="heal_stamina_flat">Restore Stamina (Flat)</option>
                </optgroup>
                {{/select}}
              </select>
            </div>
            <div class="dropdown-field">
              <label class="resource-label secondary-input">Effect Value</label>
              <input class="tertiary-input" type="text" name="system.effect_value" value="{{system.effect_value}}"
                placeholder="0" data-dtype="Number" />
            </div>
            <div class="dropdown-field">
              <label class="resource-label secondary-input">Elixir Sickness +</label>
              <input class="tertiary-input" type="text" name="system.elixir_sickness_amount" value="{{system.elixir_sickness_amount}}"
                placeholder="1" data-dtype="Number" />
            </div>
          </div>
        </div>
      </div>
      {{/if}}

    </div>
  </div>
</form>

{{log system}}
