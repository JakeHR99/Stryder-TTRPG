<form class="{{cssClass}} fantasy-item-sheet" autocomplete="off">
  <div class="oi-frame sty-ornate">
    {{> "systems/stryder/templates/item/parts/ornate-header.hbs" typeLabel="Component Item"}}

    {{!-- Extra header: Type, Rank, Sell Price --}}
    <div class="oi-extra-header">
      <div class="grid grid-2col">
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Component Type</label>
          <select class="secondary-input" name="system.component_type">
            {{#sty-select system.component_type}}
            <option value="bones">Bones</option>
            <option value="eyes">Eyes</option>
            <option value="mana_veins">Mana Veins</option>
            <option value="heart">Heart</option>
            {{/sty-select}}
          </select>
        </div>
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Rank</label>
          <select class="secondary-input" name="system.rank">
            {{#sty-select system.rank}}
            <option value="4">Rank 4</option>
            <option value="3">Rank 3</option>
            <option value="2">Rank 2</option>
            <option value="1">Rank 1</option>
            <option value="mythic">Mythic</option>
            {{/sty-select}}
          </select>
        </div>
      </div>
      <div class="grid grid-2col" style="margin-top:4px;">
        <div class="dropdown-field">
          <label class="resource-label secondary-input">Sell Price (Grail)</label>
          <input class="tertiary-input" type="text" name="system.sell_price" value="{{system.sell_price}}" placeholder="0" data-dtype="Number" />
        </div>
      </div>
    </div>

    {{!-- Content Area --}}
    <div class="oi-content-area">
      <div class="editor-container">
        <div class="editor-header">
          <i class="fas fa-cog"></i> Component Description
        </div>
        {{editor system.description target="system.description" rollData=rollData button=true owner=owner editable=editable}}
      </div>
    </div>
  </div>
</form>

{{log system}}
