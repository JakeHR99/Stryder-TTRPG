<div class="challenges-hub-content">

  <div class="challenges-hub-header">
    <p class="challenges-intro">Camp Activities &amp; Mini-Games — click a card to begin.</p>
  </div>

  <ol class="challenges-list">
    {{#each challenges}}
    <li class="challenge-card" data-challenge="{{id}}">

      <div class="challenge-thumb">{{icon}}</div>

      <div class="challenge-body">
        <div class="challenge-name">{{name}}</div>
        <div class="challenge-desc">{{description}}</div>
        <div class="challenge-flavor">{{flavor}}</div>
        <div class="challenge-tags">
          {{#each tags}}<span class="challenge-tag">{{this}}</span>{{/each}}
        </div>
      </div>

      <div class="challenge-actions">
        <button type="button" class="challenge-launch-btn" data-challenge="{{id}}" title="Start {{name}}">
          <i class="fas fa-play"></i><br/>Play
        </button>
      </div>

    </li>
    {{/each}}
  </ol>

  <div class="challenges-hub-footer">
    <p>More activities coming soon...</p>
  </div>

</div>
