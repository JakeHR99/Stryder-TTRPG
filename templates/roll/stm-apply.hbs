{{#if flavor}}<span class="flavor-text">{{flavor}}</span>{{/if}}
{{#if nofix}}
<div class="dice-roll">
    <div class="dice-result">
        <div class="dice-formula">{{formula}} : <b class="sty-roll-formula-val">{{resultValue}}</b>{{#if limit}} ({{totalValue}}){{/if}}</div>
        {{{tooltip}}}
    </div>
</div>
{{/if}}
<div class="flexrow flex-group-center grid grid-4col nogapmargin">
    <div class="grid-span-3" style="text-align: center;">
        HP<span class="sty-roll-val"> {{targetHP}}</span>
        >>><span class="sty-roll-val"> {{resultHP}}</span>
    </div>
</div>
