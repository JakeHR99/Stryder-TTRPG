{{#if flavor}}<span class="flavor-text">{{flavor}}</span>{{/if}}
<div class="flexrow flex-group-center grid grid-5col nogapmargin">
    <div class="grid-span-3" style="text-align: center;">
        {{#if isView}}
        MP<span class="sty-roll-val"> {{targetMP}}</span>
        >>><span class="sty-roll-val"> {{resultMP}}</span>
        {{/if}}
    </div>
    <div>
        {{#if metaB}}<button class="buttonclick" data-buttontype="buttonmeta">{{localize "Spend Mana"}}</button>{{/if}}
    </div>
    <div>
        <button class="buttonclick" data-buttontype="buttonmpcancel">{{localize "Cancel"}}</button>
    </div>
</div>
