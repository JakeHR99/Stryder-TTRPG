<form class="{{cssClass}} ps-form" autocomplete="off">
  <div class="ps-sheet-wrap">

    {{!-- ═══ SKY BACKDROP & SMOKE CLOUDS ═══ --}}
    <div class="ps-sky" aria-hidden="true">
      <div class="ps-smoke"></div>
    </div>

    {{!-- ═══ TITLE BAR ═══ --}}
    <header class="ps-title-bar">
      <img class="ps-title-avatar" src="{{actor.img}}" data-edit="img" title="Edit party image" />
      <div class="ps-title-text">
        <input class="ps-name-input" name="name" type="text" value="{{actor.name}}" placeholder="Party Name" />
        <div class="ps-name-sub">Party · {{members.length}} Members</div>
      </div>
    </header>

    {{!-- ═══ CONTENT AREA (pages swap here) ═══ --}}
    <div class="ps-content-area">

      {{!-- ─── PARTY PAGE ─── --}}
      <div class="ps-page" data-page="party">
        <div class="ps-carousel-wrap">
          {{!-- Left arrow: JS shows/hides based on page --}}
          <button class="ps-arrow ps-arrow-left" type="button" style="display:none;">‹</button>
          {{!-- Right arrow: shown only when 5+ members --}}
          <button class="ps-arrow ps-arrow-right" type="button" {{#unless hasOverflow}}style="display:none;"{{/unless}}>›</button>

          <div class="ps-members-grid">
          {{#each memberSlots as |m|}}

          {{#if m.isEmpty}}
          {{!-- Empty slot placeholder --}}
          <div class="ps-member-card ps-card-empty">
            <div class="ps-card-art-wrap">
              <div class="ps-card-empty-art">
                <div class="ps-card-empty-icon">+</div>
                <div class="ps-card-empty-text">Drag a character here</div>
              </div>
            </div>
            <div class="ps-card-stats ps-card-stats-empty">
              <div class="ps-card-name ps-card-name-empty">Empty Slot</div>
            </div>
          </div>

          {{else}}
          {{!-- Filled member card --}}
          <div class="ps-member-card" data-uuid="{{m.uuid}}">

            <div class="ps-card-art-wrap">
              <img class="ps-card-art" src="{{m.actorImg}}" alt="{{m.name}}" />
              <div class="ps-card-lv-wrap">
                <div class="ps-card-lv-label">Lv̂l</div>
                <div class="ps-card-lv-diamond">
                  <span class="ps-card-lv-num">{{m.level}}</span>
                </div>
              </div>
              <div class="ps-card-hover-overlay"><span>Open Sheet</span></div>
            </div>

            <div class="ps-card-stats">
              <div class="ps-card-name">{{m.name}}</div>
              <div class="ps-card-sub">
                {{#if m.className}}{{m.className}}{{/if}}{{#if m.folkName}} · {{m.folkName}}{{/if}}
              </div>
              <div class="ps-card-bars">
                <div class="ps-bar-row">
                  <span class="ps-bar-label ps-hp">HP</span>
                  <div class="ps-bar-track"><div class="ps-bar-fill ps-hp" style="width:{{m.health.pct}}%"></div></div>
                  <span class="ps-bar-val">{{m.health.value}}<span class="ps-bar-max">/{{m.health.max}}</span></span>
                </div>
                <div class="ps-bar-row">
                  <span class="ps-bar-label ps-mp">MP</span>
                  <div class="ps-bar-track"><div class="ps-bar-fill ps-mp" style="width:{{m.mana.pct}}%"></div></div>
                  <span class="ps-bar-val">{{m.mana.value}}<span class="ps-bar-max">/{{m.mana.max}}</span></span>
                </div>
                <div class="ps-bar-row">
                  <span class="ps-bar-label ps-sta">STA</span>
                  <div class="ps-bar-track"><div class="ps-bar-fill ps-sta" style="width:{{m.stamina.pct}}%"></div></div>
                  <span class="ps-bar-val">{{m.stamina.value}}<span class="ps-bar-max">/{{m.stamina.max}}</span></span>
                </div>
              </div>
              <i class="ps-card-remove fas fa-sign-out-alt" data-uuid="{{m.uuid}}" title="Leave party"></i>
            </div>

          </div>{{!-- .ps-member-card --}}
          {{/if}}

          {{/each}}
          </div>{{!-- .ps-members-grid --}}
        </div>{{!-- .ps-carousel-wrap --}}
      </div>{{!-- party page --}}

      {{!-- ─── EXPEDITION PAGE ─── --}}
      <div class="ps-page" data-page="expedition">
        <div class="ps-interior-placeholder">
          <div class="ps-ph-icon">🗺</div>
          <div class="ps-ph-title">Expedition</div>
          <div class="ps-ph-body">Track your journey, manage travel across the world, and log discoveries made along the way.</div>
          <div class="ps-ph-badge">Coming Soon</div>
        </div>
      </div>

      {{!-- ─── CAMPING PAGE ─── --}}
      <div class="ps-page" data-page="camping">
        <div class="ps-interior">
          <div class="ps-interior-header">🏕 Camp Tasks</div>
          <div class="ps-interior-hint">Available when the party draws a Campsite from the Expedition Deck.</div>
          <ol class="ps-item-list">
            {{#each campTasks as |item|}}
            <li class="ps-item" data-item-id="{{item.id}}">
              <img class="ps-item-img" src="{{item.img}}" title="{{item.name}}" />
              <span class="ps-item-name">{{item.name}}</span>
              <div class="ps-item-controls">
                <a class="ps-item-roll" title="Use"><i class="fas fa-dice-d20"></i></a>
                <a class="ps-item-delete" title="Delete"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{else}}
            <li class="ps-item-empty">No camp tasks. Drag action items here and enable isCampTask.</li>
            {{/each}}
          </ol>
        </div>
      </div>

      {{!-- ─── CHALLENGES PAGE ─── --}}
      <div class="ps-page" data-page="challenges">
        <div class="ch2-wrap">

          {{!-- Fishing — active --}}
          <div class="ch2-card ch2-active" data-challenge="fishing">
            <img class="ch2-sprite" src="systems/stryder/assets/fishing/fish_06.png" alt="Fishing" />
            <div class="ch2-title">Fishing</div>
            <button class="ch2-play-btn ch-play-btn" data-challenge="fishing" type="button">▶ Play</button>
          </div>

          {{!-- Locked activities --}}
          <div class="ch2-locked-row">
            <div class="ch2-card ch2-locked">
              <div class="ch2-lock-icon">🔒</div>
              <div class="ch2-lock-name">Foraging</div>
              <div class="ch2-soon">Coming Soon</div>
            </div>
            <div class="ch2-card ch2-locked">
              <div class="ch2-lock-icon">🔒</div>
              <div class="ch2-lock-name">Mining</div>
              <div class="ch2-soon">Coming Soon</div>
            </div>
          </div>

        </div>
      </div>

      {{!-- ─── INVENTORY PAGE ─── --}}
      <div class="ps-page" data-page="inventory">
        <div class="ps-interior">
          <div class="ps-interior-header">🎒 Shared Inventory</div>
          <div class="ps-interior-hint">Items carried by the party. Drag items onto this sheet to stash them — drag a row onto your character sheet (or click the hand) to take one.</div>
          <ol class="ps-item-list">
            {{#each inventory as |item|}}
            <li class="ps-item" data-item-id="{{item.id}}">
              <img class="ps-item-img" src="{{item.img}}" title="{{item.name}}" />
              <span class="ps-item-name">{{item.name}}{{#if (gt item.system.quantity 1)}} <span class="ps-item-qty">×{{item.system.quantity}}</span>{{/if}}</span>
              <span class="ps-item-type">{{item.type}}</span>
              <div class="ps-item-controls">
                <a class="ps-item-take" title="Take to my character"><i class="fas fa-hand-holding"></i></a>
                <a class="ps-item-delete" title="Delete"><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{else}}
            <li class="ps-item-empty">No shared items yet. Drag items onto the party sheet.</li>
            {{/each}}
          </ol>
        </div>
      </div>

    </div>{{!-- .ps-content-area --}}

    {{!-- ═══ BOTTOM FLOATING NAV ═══ --}}
    <nav class="ps-bottom-nav">
      <button type="button" class="ps-nav-btn" data-target="party">Party</button>
      <span class="ps-nav-sep">·</span>
      <button type="button" class="ps-nav-btn" data-target="expedition">Expedition</button>
      <span class="ps-nav-sep">·</span>
      <button type="button" class="ps-nav-btn" data-target="camping">Camping</button>
      <span class="ps-nav-sep">·</span>
      <button type="button" class="ps-nav-btn" data-target="challenges">Challenges</button>
      <span class="ps-nav-sep">·</span>
      <button type="button" class="ps-nav-btn" data-target="inventory">Inventory</button>
    </nav>

  </div>{{!-- .ps-sheet-wrap --}}
</form>
