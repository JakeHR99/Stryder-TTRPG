<form class="{{cssClass}} {{actor.type}} jrpg-sheet lrd-v2" autocomplete="off">
<style>
/* ── Lordling v2 layout ── */
.lrd-v2.jrpg-sheet { background: #06101e; }

.lrd-v2 .jrpg-main-screen {
  flex-direction: column !important;
}

/* Hero */
.lrd-v2 .lrd-hero {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.lrd-v2 .lrd-video-bg {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
}
.lrd-v2 .lrd-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom,
    rgba(5,10,30,0.05) 0%,
    rgba(5,10,30,0.15) 35%,
    rgba(5,10,30,0.72) 68%,
    rgba(5,10,30,0.94) 100%);
  z-index: 1;
}

/* Portrait */
.lrd-v2 .lrd-portrait-wrap {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 68%; height: 78%;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.lrd-v2 .lrd-portrait-img {
  width: auto !important; height: 100% !important;
  max-width: 100% !important;
  object-fit: contain !important;
  object-position: bottom center !important;
  filter: drop-shadow(0 10px 28px rgba(20,60,160,0.55));
  cursor: pointer;
  border: none !important;
  background: transparent !important;
  border-radius: 0 !important;
}

/* Identity */
.lrd-v2 .lrd-identity {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  z-index: 3;
  padding: 10px 18px 12px;
  text-align: center;
}
.lrd-v2 .lrd-name-input {
  background: transparent !important;
  border: none !important;
  border-bottom: 1px solid rgba(100,140,220,0.2) !important;
  color: rgba(230,240,255,0.95) !important;
  font-family: 'Cinzel', serif !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  letter-spacing: 2.5px !important;
  text-transform: uppercase !important;
  width: 100% !important;
  padding: 0 0 3px !important;
  margin-bottom: 3px !important;
  outline: none !important;
  box-shadow: none !important;
  text-align: center !important;
}
.lrd-v2 .lrd-bound-text {
  font-family: 'Rajdhani', sans-serif;
  font-size: 10px;
  color: rgba(120,150,210,0.5);
  margin-bottom: 8px;
  text-align: center;
}
.lrd-v2 .lrd-bound-name { color: rgba(155,190,255,0.78); font-weight: 700; }
.lrd-v2 .lrd-unbound { color: rgba(85,100,155,0.45); font-style: italic; }

/* Side-by-side bars */
.lrd-v2 .lrd-bars-duo {
  display: flex;
  gap: 10px;
}
.lrd-v2 .lrd-bar-half {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 5px;
}
.lrd-v2 .lrd-bar-label {
  font-family: 'Rajdhani', sans-serif;
  font-weight: 700;
  font-size: 9px;
  letter-spacing: 1.5px;
  flex-shrink: 0;
  text-transform: uppercase;
}
.lrd-v2 .lrd-hp-lbl { color: rgba(205,80,80,0.85); }
.lrd-v2 .lrd-tp-lbl { color: rgba(205,178,55,0.85); }
.lrd-v2 .lrd-bar-track {
  flex: 1;
  height: 5px;
  background: rgba(255,255,255,0.09);
  border-radius: 3px;
  overflow: hidden;
  min-width: 0;
}
.lrd-v2 .lrd-bar-fill { height: 100%; border-radius: 3px; transition: width 0.3s; }
.lrd-v2 .lrd-hp-fill { background: linear-gradient(90deg, rgba(150,35,35,0.9), rgba(215,70,70,0.9)); }
.lrd-v2 .lrd-tp-fill { background: linear-gradient(90deg, rgba(125,95,10,0.9), rgba(210,175,30,0.9)); }
.lrd-v2 .lrd-bar-values {
  font-family: 'Rajdhani', sans-serif;
  font-size: 10px; font-weight: 600;
  color: rgba(210,225,255,0.72);
  display: flex; align-items: center; gap: 1px;
  flex-shrink: 0; white-space: nowrap;
}
.lrd-v2 .lrd-bar-num {
  background: transparent !important;
  border: none !important;
  color: inherit !important;
  font: inherit !important;
  width: 22px; text-align: right;
  padding: 0 !important; outline: none !important; box-shadow: none !important;
}
.lrd-v2 .lrd-tp-max { color: rgba(158,130,42,0.6) !important; font-size: 9px !important; width: 18px !important; }
.lrd-v2 .lrd-bar-sep { color: rgba(120,140,195,0.38); margin: 0 1px; }

/* Nav panels */
.lrd-v2 .lrd-nav-panels {
  display: flex !important;
  flex-direction: row !important;
  flex-shrink: 0;
  height: 115px;
  border-top: 1px solid rgba(50,90,200,0.18);
  background: rgba(4,9,24,0.98);
}
.lrd-v2 .lrd-panel-btn {
  flex: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-right: 1px solid rgba(45,80,180,0.14) !important;
  cursor: pointer !important;
  transition: background 0.15s !important;
  clip-path: none !important;
  color: rgba(155,190,240,0.65) !important;
  width: auto !important; height: 100% !important;
  box-shadow: none !important; text-shadow: none !important;
}
.lrd-v2 .lrd-panel-btn:last-child { border-right: none !important; }
.lrd-v2 .lrd-panel-btn:hover {
  background: rgba(15,28,80,0.9) !important;
  color: rgba(210,230,255,0.95) !important;
  clip-path: none !important;
}
.lrd-v2 .lrd-panel-btn:hover .lrd-panel-icon { opacity: 1; }
.lrd-v2 .lrd-panel-icon {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0.55; transition: opacity 0.15s;
}
.lrd-v2 .lrd-panel-svg {
  width: 30px !important; height: 30px !important;
  object-fit: contain !important;
  filter: invert(1) brightness(2) !important;
  border: none !important; background: transparent !important;
}
.lrd-v2 .lrd-panel-label {
  font-family: 'Cinzel', serif !important;
  font-size: 10px !important; font-weight: 700 !important;
  letter-spacing: 2.5px !important; text-transform: uppercase !important;
  line-height: 1 !important;
}

/* Sub-screen */
.lrd-v2 .jrpg-sub-content { padding: 14px !important; }

/* Inline button reset */
.lrd-v2 .lrd-inline-btn,
.lordling .lrd-tactic-quick {
  display: inline-flex !important; width: auto !important;
  align-items: center !important; justify-content: center !important;
  flex: 0 0 auto !important; line-height: 1 !important;
  box-shadow: none !important; text-shadow: none !important; transform: none !important;
}
.lrd-v2 .lrd-inline-btn:hover { filter: brightness(1.2); }
.lordling .lrd-tactic-quick:hover { filter: brightness(1.25); transform: translateY(-1px) !important; }

/* ── Battle sub-page redesign ── */
.lrd-v2 .jrpg-battle-wrap { gap: 8px !important; }
.lrd-v2 .lrd-cfg-strip {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px;
  background: rgba(4,8,28,0.88);
  border: 1px solid rgba(50,80,195,0.22);
  border-radius: 5px; flex-wrap: wrap;
}
.lrd-v2 .lrd-cfg-lbl {
  font-family: 'Cinzel', serif; font-size: 8px;
  letter-spacing: .1em; text-transform: uppercase;
  color: rgba(155,185,240,0.8); flex-shrink: 0;
}
.lrd-v2 .lrd-cfg-select,
.lrd-v2 .lrd-cfg-btn {
  background: rgba(7,12,38,0.92) !important;
  border: 1px solid rgba(48,78,170,0.35) !important;
  border-radius: 3px !important;
  color: rgba(180,205,250,0.9) !important;
  font-family: 'Rajdhani', sans-serif !important;
  font-size: 11px !important; padding: 2px 8px !important;
  cursor: pointer !important; clip-path: none !important;
  box-shadow: none !important; text-shadow: none !important;
  width: auto !important; line-height: 1.5 !important;
  color-scheme: dark !important;
}
.lrd-v2 .lrd-cfg-select option {
  background: #08102a !important;
  color: rgba(180,205,250,0.9) !important;
}
.lrd-v2 .lrd-cfg-btn:hover, .lrd-v2 .lrd-cfg-select:hover {
  background: rgba(18,32,85,0.95) !important;
  border-color: rgba(80,120,230,0.55) !important;
}
.lrd-v2 .lrd-tactics-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 5px;
}
.lrd-v2 .lrd-tactic-btn {
  width: 100% !important; display: flex !important;
  justify-content: center !important;
  padding: 9px 6px !important;
  clip-path: none !important; transform: none !important;
  box-shadow: 0 1px 4px rgba(0,0,0,0.3) !important;
}
.lrd-v2 .lrd-tactic-btn:hover {
  clip-path: none !important; transform: none !important;
}
.lrd-v2 .lrd-full-width { grid-column: span 2; }
.lrd-v2 .lrd-battle-mid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.lrd-v2 .lrd-section-hdr {
  font-family: 'Cinzel', serif; font-size: 8px;
  letter-spacing: .14em; text-transform: uppercase;
  color: rgba(100,140,215,0.5);
  margin-bottom: 7px; padding-bottom: 4px;
  border-bottom: 1px solid rgba(45,75,180,0.18);
  display: flex; align-items: center; justify-content: space-between;
}
.lrd-v2 .lrd-section-maxnote {
  font-family: 'Rajdhani', sans-serif; font-weight: 400;
  font-size: 8px; color: rgba(90,120,190,0.38); letter-spacing: .04em;
}
.lrd-v2 .lrd-features-wrap {
  border-top: 1px solid rgba(40,60,155,0.18); padding-top: 8px;
}

/* ── TP Tracker ── */
.lrd-v2 .lrd-tp-tracker {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 12px;
  background: rgba(4,8,28,0.88);
  border: 1px solid rgba(80,60,10,0.35);
  border-radius: 5px;
}
.lrd-v2 .lrd-tp-adj {
  width: 30px; height: 30px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(12,10,2,0.85);
  border: 1px solid rgba(140,110,20,0.4);
  border-radius: 4px;
  color: rgba(210,175,50,0.85);
  font-family: 'Rajdhani', sans-serif;
  font-size: 18px; font-weight: 700; line-height: 1;
  cursor: pointer;
  transition: background 0.12s, border-color 0.12s, color 0.12s;
}
.lrd-v2 .lrd-tp-adj:hover {
  background: rgba(30,24,5,0.95);
  border-color: rgba(210,170,30,0.65);
  color: rgba(240,205,60,1);
}
.lrd-v2 .lrd-tp-tracker-mid { flex: 1; display: flex; flex-direction: column; gap: 5px; }
.lrd-v2 .lrd-tp-tracker-nums {
  display: flex; align-items: baseline; gap: 4px;
}
.lrd-v2 .lrd-tp-cur {
  font-family: 'Rajdhani', sans-serif;
  font-size: 26px; font-weight: 700; line-height: 1;
  color: rgba(225,190,45,0.95);
}
.lrd-v2 .lrd-tp-sep, .lrd-v2 .lrd-tp-max-display {
  font-family: 'Rajdhani', sans-serif;
  font-size: 14px; color: rgba(145,115,25,0.6);
}
.lrd-v2 .lrd-tp-tracker-label {
  font-family: 'Cinzel', serif;
  font-size: 8px; letter-spacing: .15em; text-transform: uppercase;
  color: rgba(205,178,55,0.45);
  margin-left: auto;
}
.lrd-v2 .lrd-tp-track {
  height: 3px; border-radius: 2px;
  background: rgba(255,255,255,0.07); overflow: hidden;
}
.lrd-v2 .lrd-tp-track-fill {
  height: 100%; border-radius: 2px;
  background: linear-gradient(90deg, rgba(125,95,10,0.9), rgba(210,175,30,0.9));
  transition: width 0.3s;
}
</style>

  <!-- =============================================
       MAIN SCREEN — Video Hero + Nav Panels
       ============================================= -->
  <div class="jrpg-main-screen">

    <!-- ── Hero ── -->
    <div class="lrd-hero">
      <video class="lrd-video-bg" autoplay loop muted playsinline>
        <source src="systems/stryder/assets/lordling-banner.mp4" type="video/mp4">
      </video>
      <div class="lrd-hero-overlay"></div>

      <div class="lrd-portrait-wrap">
        <img src="{{actor.img}}" class="lrd-portrait-img" data-edit="img" title="Click to change portrait" />
      </div>

      <div class="lrd-identity">
        <input type="text" name="name" value="{{actor.name}}" class="lrd-name-input" placeholder="Lordling Name" />
        <div class="lrd-bound-text">
          {{#if linkedCharacterName}}
            Lordling bound to <strong class="lrd-bound-name">{{linkedCharacterName}}</strong>
          {{else}}
            <span class="lrd-unbound">— Unbound —</span>
          {{/if}}
        </div>
        <!-- HP + TP side by side -->
        <div class="lrd-bars-duo">
          <div class="lrd-bar-half">
            <span class="lrd-bar-label lrd-hp-lbl">HP</span>
            <div class="lrd-bar-track"><div class="lrd-bar-fill lrd-hp-fill" style="width:{{hpPct}}%"></div></div>
            <span class="lrd-bar-values">
              <input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" class="lrd-bar-num" />
              <span class="lrd-bar-sep">/</span>{{system.health.max}}
            </span>
          </div>
          <div class="lrd-bar-half">
            <span class="lrd-bar-label lrd-tp-lbl">TP</span>
            <div class="lrd-bar-track"><div class="lrd-bar-fill lrd-tp-fill" style="width:{{tpPct}}%"></div></div>
            <span class="lrd-bar-values">
              <input type="number" name="system.tactics.value" value="{{system.tactics.value}}" data-dtype="Number" class="lrd-bar-num" />
              <span class="lrd-bar-sep">/</span>
              <input type="number" name="system.tactics.max" value="{{system.tactics.max}}" data-dtype="Number" class="lrd-bar-num lrd-tp-max" />
            </span>
          </div>
        </div>
      </div>
    </div><!-- /.lrd-hero -->

    <!-- ── Navigation Panels ── -->
    <div class="lrd-nav-panels">
      <button type="button" class="jrpg-menu-btn lrd-panel-btn" data-target="battle">
        <div class="lrd-panel-icon">
          <img src="systems/stryder/assets/turn-start.svg" class="lrd-panel-svg" />
        </div>
        <span class="lrd-panel-label">Battle</span>
      </button>
      <button type="button" class="jrpg-menu-btn lrd-panel-btn" data-target="exploration">
        <div class="lrd-panel-icon">
          <img src="systems/stryder/assets/movement-speeds.svg" class="lrd-panel-svg" />
        </div>
        <span class="lrd-panel-label">Exploration</span>
      </button>
    </div>

  </div><!-- /.jrpg-main-screen -->


  <!-- =============================================
       SUB-SCREEN
       ============================================= -->
  <div class="jrpg-sub-screen" style="display:none;">
    <div class="jrpg-sub-header">
      <button type="button" class="jrpg-back-btn">&#8592; Back</button>
      <span class="jrpg-sub-title"></span>
    </div>

    <div class="jrpg-sub-content">

      <!-- ===== BATTLE PAGE ===== -->
      <div class="jrpg-page" data-page="battle">
        <div class="jrpg-battle-wrap">

          <!-- Config: Size / Aspect / Form -->
          <div class="lrd-cfg-strip">
            <span class="lrd-cfg-lbl">Size</span>
            <select name="system.attributes.creature_size" class="lrd-cfg-select">
              {{#sty-select system.attributes.creature_size}}
              <option value="0.5">Small</option>
              <option value="1">Normal</option>
              <option value="2">Huge</option>
              <option value="3">Massive</option>
              {{/sty-select}}
            </select>
            <span class="lrd-cfg-lbl">Aspect</span>
            <button type="button" data-action="setLordlingAspect" class="lrd-cfg-btn lrd-action-btn">
              {{#if (lookup actor.flags.stryder 'lordlingAspect')}}{{lookup actor.flags.stryder 'lordlingAspect'}}{{else}}— Set —{{/if}}
            </button>
            <span class="lrd-cfg-lbl">Form</span>
            <button type="button" data-action="setLordlingForm" class="lrd-cfg-btn lrd-action-btn">
              {{#if (lookup actor.flags.stryder 'lordlingForm')}}{{lookup actor.flags.stryder 'lordlingForm'}}{{else}}— Set —{{/if}}
            </button>
          </div>

          <!-- Tactic Points tracker -->
          <div class="lrd-tp-tracker">
            <button type="button" class="lrd-tp-adj" data-delta="-1">−</button>
            <div class="lrd-tp-tracker-mid">
              <div class="lrd-tp-tracker-nums">
                <span class="lrd-tp-cur">{{system.tactics.value}}</span>
                <span class="lrd-tp-sep">/</span>
                <span class="lrd-tp-max-display">{{system.tactics.max}}</span>
                <span class="lrd-tp-tracker-label">Tactic Points</span>
              </div>
              <div class="lrd-tp-track">
                <div class="lrd-tp-track-fill" style="width:{{tpPct}}%"></div>
              </div>
            </div>
            <button type="button" class="lrd-tp-adj" data-delta="1">+</button>
          </div>

          <!-- Quick Tactics grid -->
          <div class="lrd-tactics-grid">
            <button type="button" class="jrpg-battle-action-btn lrd-tactic-btn lrd-tactic-quick" data-tactic="attack">⚔ Attack</button>
            <button type="button" class="jrpg-battle-action-btn lrd-tactic-btn lrd-tactic-quick" data-tactic="heal">✦ Heal</button>
            <button type="button" class="jrpg-battle-action-btn lrd-tactic-btn lrd-tactic-quick" data-tactic="dodge">🛡 Dodge</button>
            <button type="button" class="jrpg-battle-action-btn lrd-tactic-btn lrd-tactic-quick" data-tactic="metamorph">🌀 Morph</button>
            <button type="button" class="jrpg-battle-action-btn lrd-tactic-btn lrd-tactic-quick lrd-full-width" data-tactic="retreat">↩ Retreat</button>
          </div>

          <!-- Stats (left) + Combat rolls (right) -->
          <div class="lrd-battle-mid">

            <!-- Stats -->
            <div>
              <div class="lrd-section-hdr">Stats <span class="lrd-section-maxnote">max 5</span></div>
              {{#each system.abilities as |ability key|}}
              {{#unless (eq key 'Intuition')}}
              <div class="jrpg-stat-row">
                <label class="jrpg-char-label">{{#if (eq key 'Soul')}}Spirit{{else}}{{key}}{{/if}}</label>
                <div class="jrpg-stat-stepper">
                  <button type="button" class="stat-btn stat-btn-down" data-stat="{{key}}">−</button>
                  <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" class="jrpg-char-input jrpg-stat-input" min="0" max="5" />
                  <button type="button" class="stat-btn stat-btn-up" data-stat="{{key}}">+</button>
                </div>
              </div>
              {{/unless}}
              {{/each}}
            </div>

            <!-- Combat rolls -->
            <div>
              <div class="lrd-section-hdr">Combat</div>
              <div class="jrpg-defense-panel">
                <div class="jrpg-defense-header">Rolls</div>
                <div class="jrpg-defense-grid">
                  <span class="jrpg-defense-row rollable"
                    data-roll="2*@abilities.Soul.value+@attributes.mastery+@attributes.physical_potency.mod"
                    data-label="Physical Potency">P. Potency</span>
                  <span class="jrpg-defense-row rollable"
                    data-roll="2d6+@abilities.Grit.value+@checks.Physical.mod"
                    data-label="Physical Resist">P. Resist</span>
                  <span class="jrpg-defense-row rollable"
                    data-roll="2*@abilities.Soul.value+@attributes.mastery+@attributes.magykal_potency.mod"
                    data-label="Magykal Potency">M. Potency</span>
                  <span class="jrpg-defense-row rollable"
                    data-roll="2d6+@abilities.Will.value+@checks.Magykal.mod"
                    data-label="Magykal Resist">M. Resist</span>
                  <span class="jrpg-defense-row rollable"
                    data-custom-roll="1d6+@abilities.Reflex.value+@dodge.bonus"
                    data-label="Dodge">Dodge</span>
                  <span class="jrpg-defense-row rollable"
                    data-custom-roll="2d6+@abilities.Reflex.value+@evade.bonus"
                    data-label="Evade">Evade</span>
                </div>
              </div>
            </div>

          </div><!-- /.lrd-battle-mid -->

          <!-- Lordly Features -->
          <div class="lrd-features-wrap">
            <div class="lrd-section-hdr">Lordly Features</div>
            {{> "systems/stryder/templates/actor/parts/lordling-features.hbs"}}
          </div>

        </div>
      </div><!-- /battle -->


      <!-- ===== EXPLORATION PAGE ===== -->
      <div class="jrpg-page" data-page="exploration">
        <div class="jrpg-char-edit">

          <!-- Link Character -->
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;padding:6px 10px;background:rgba(6,12,38,0.6);border:1px solid rgba(40,65,155,0.18);border-radius:4px;">
            <span style="font-family:'Cinzel',serif;font-size:8px;letter-spacing:.08em;color:rgba(95,125,195,0.4);text-transform:uppercase;flex-shrink:0;">Linked Character</span>
            <select id="linked-character-select" name="system.linkedCharacterId"
              style="background:rgba(7,12,38,0.88);border:1px solid rgba(48,80,175,0.25);border-radius:3px;color:rgba(150,182,238,0.82);font-family:'Rajdhani',sans-serif;font-size:11px;padding:2px 5px;flex:1;min-width:0;">
              <option value="">— None —</option>
              {{#each characters}}
              <option value="{{this.id}}" {{#if (eq this.id ../system.linkedCharacterId)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <!-- Talents -->
          <div class="jrpg-char-section">
            <h3 class="jrpg-char-section-title">Talents</h3>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:4px;">
              {{#each system.attributes.talent as |talent key|}}
              <div style="display:flex;align-items:center;gap:8px;padding:5px 8px;background:rgba(6,12,36,0.6);border:1px solid rgba(40,65,155,0.18);border-radius:4px;">
                <span class="rollable" data-roll="2d6+@attributes.talent.{{key}}.value" data-label="{{key}}"
                  style="flex:1;font-family:'Cinzel',serif;font-size:9px;letter-spacing:.04em;color:rgba(155,185,240,0.7);cursor:pointer;text-transform:capitalize;">{{key}}</span>
                <input type="text" name="system.attributes.talent.{{key}}.value" value="{{talent.value}}" data-dtype="Number"
                  style="width:34px;text-align:center;background:rgba(10,18,50,0.7);border:1px solid rgba(50,85,190,0.25);border-radius:3px;color:rgba(210,230,255,0.9);font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:700;padding:2px 0;" />
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Movement -->
          <div class="jrpg-char-section" style="margin-top:16px;">
            <h3 class="jrpg-char-section-title">Movement</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;">
              {{#each system.attributes.move as |move key|}}
              <div style="display:flex;align-items:center;gap:8px;padding:5px 8px;background:rgba(6,12,36,0.6);border:1px solid rgba(40,65,155,0.18);border-radius:4px;">
                <span style="flex:1;font-family:'Cinzel',serif;font-size:9px;color:rgba(130,165,225,0.6);text-transform:capitalize;">{{key}}</span>
                <div style="width:8px;height:8px;border-radius:50%;flex-shrink:0;{{#if move.expertise}}background:rgba(80,180,100,0.7);{{else}}background:rgba(60,80,140,0.35);border:1px solid rgba(60,80,140,0.25);{{/if}}"></div>
                <input type="text" name="system.attributes.move.{{key}}.value" value="{{move.value}}" data-dtype="Number" readonly
                  style="width:30px;text-align:center;background:rgba(10,18,50,0.7);border:1px solid rgba(50,85,190,0.2);border-radius:3px;color:rgba(190,215,255,0.85);font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:700;padding:2px 0;" />
              </div>
              {{/each}}
            </div>
          </div>

        </div>
      </div><!-- /exploration -->

    </div><!-- /.jrpg-sub-content -->
  </div><!-- /.jrpg-sub-screen -->

</form>
