{{!-- Section 1: Stats & Potencies --}}
<div class="fantasy-abilities-section">
	<div class="combat-abilities-header">
		<h3 class="fantasy-section-title">
			<span class="title-decoration left"></span>
			<span class="title-text">Stats</span>
			<span class="title-decoration right"></span>
		</h3>
	</div>
	<div class="stats-abilities-grid stats-grid-2x2">

		{{!-- Row 1: Soul | Reflex --}}
		<div class="ability flex-group-center stat-font fantasy-ability">
			<label class="ability-label" title="This stat measures the strength of your Soul Armament. This affects the damage your attacks and Skills deal. It also raises your Potency making your Skills harder to Resist."><b>{{system.abilities.Soul.label}}</b></label>
			<div class="ability-input-container">
				<input type="text" name="system.abilities.Soul.value" value="{{system.abilities.Soul.value}}" data-dtype="Number" class="fantasy-ability-input" />
				<div class="ability-input-glow"></div>
			</div>
			<span class="ability-mod rollable" data-roll="2d6+@abilities.Soul.value" data-label="Soul Check">
				<div class="dice-container">
					<img src="systems/stryder/assets/d6.svg" width="25" height="25" style="border:0px">
					<div class="dice-glow"></div>
				</div>
			</span>
		</div>

		<div class="ability flex-group-center stat-font fantasy-ability">
			<label class="ability-label" title="Combat reflexes and evasiveness. Reflexes provides survivability on the battlefield as well as increasing your ability to Dodge."><b>{{system.abilities.Reflex.label}}</b></label>
			<div class="ability-input-container">
				<input type="text" name="system.abilities.Reflex.value" value="{{system.abilities.Reflex.value}}" data-dtype="Number" class="fantasy-ability-input" />
				<div class="ability-input-glow"></div>
			</div>
			<span class="ability-mod rollable" data-roll="2d6+@abilities.Reflex.value" data-label="Reflex Check">
				<div class="dice-container">
					<img src="systems/stryder/assets/d6.svg" width="25" height="25" style="border:0px">
					<div class="dice-glow"></div>
				</div>
			</span>
		</div>

		{{!-- Row 2: Grit | Will --}}
		<div class="ability flex-group-center stat-font fantasy-ability">
			<label class="ability-label" title="Physical Durability and Resilience unmatched. You gain additional Health, and an increased Resistance making you harder to overwhelm."><b>{{system.abilities.Grit.label}}</b></label>
			<div class="ability-input-container">
				<input type="text" name="system.abilities.Grit.value" value="{{system.abilities.Grit.value}}" data-dtype="Number" class="fantasy-ability-input" />
				<div class="ability-input-glow"></div>
			</div>
			<span class="ability-mod rollable" data-roll="2d6+@abilities.Grit.value" data-label="Grit Check">
				<div class="dice-container">
					<img src="systems/stryder/assets/d6.svg" width="25" height="25" style="border:0px">
					<div class="dice-glow"></div>
				</div>
			</span>
		</div>

		<div class="ability flex-group-center stat-font fantasy-ability">
			<label class="ability-label" title="Will grants you incredible determination capable of surmounting the odds and even resisting abilities. This Stat raises your Resist providing additional defense against certain effects."><b>{{system.abilities.Will.label}}</b></label>
			<div class="ability-input-container">
				<input type="text" name="system.abilities.Will.value" value="{{system.abilities.Will.value}}" data-dtype="Number" class="fantasy-ability-input" />
				<div class="ability-input-glow"></div>
			</div>
			<span class="ability-mod rollable" data-roll="2d6+@abilities.Will.value" data-label="Will Check">
				<div class="dice-container">
					<img src="systems/stryder/assets/d6.svg" width="25" height="25" style="border:0px">
					<div class="dice-glow"></div>
				</div>
			</span>
		</div>

	</div>

	{{!-- Potency — single combined stat beneath the grid --}}
	<div class="stats-potency-row">
		<div class="header-stat">
			<label class="header-stat-label">P. Potency</label>
			<span class="jrpg-stat-controls">
				<button type="button" class="jrpg-stat-step" data-group="potency" data-stat="physical_potency" data-step="-1" title="Decrease (overrides the 2×Grit baseline; reach 0 to return to auto)">&minus;</button>
				<span class="jrpg-stat-total{{#if potency.physical.isFormula}} has-folk{{/if}}" title="{{#if potency.physical.isFormula}}Auto: 2×Grit = {{potency.physical.total}}{{else}}Manually set to {{potency.physical.total}} (baseline 2×Grit = {{potency.physical.formula}}){{/if}}">{{potency.physical.total}}</span>
				<button type="button" class="jrpg-stat-step" data-group="potency" data-stat="physical_potency" data-step="1" title="Increase (overrides the 2×Grit baseline)">+</button>
			</span>
		</div>
		<div class="header-stat">
			<label class="header-stat-label">M. Potency</label>
			<span class="jrpg-stat-controls">
				<button type="button" class="jrpg-stat-step" data-group="potency" data-stat="magykal_potency" data-step="-1" title="Decrease (overrides the 2×Will baseline; reach 0 to return to auto)">&minus;</button>
				<span class="jrpg-stat-total{{#if potency.magykal.isFormula}} has-folk{{/if}}" title="{{#if potency.magykal.isFormula}}Auto: 2×Will = {{potency.magykal.total}}{{else}}Manually set to {{potency.magykal.total}} (baseline 2×Will = {{potency.magykal.formula}}){{/if}}">{{potency.magykal.total}}</span>
				<button type="button" class="jrpg-stat-step" data-group="potency" data-stat="magykal_potency" data-step="1" title="Increase (overrides the 2×Will baseline)">+</button>
			</span>
		</div>
	</div>
</div>
