					<span class="jrpg-stat-total{{#if talentLayers.strength.bonus}} has-folk{{/if}}" title="Total {{talentLayers.strength.total}} — Folk/effect foundation +{{talentLayers.strength.bonus}}, your points {{talentLayers.strength.base}}">{{talentLayers.strength.total}}</span>
