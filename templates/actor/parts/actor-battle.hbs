{{!-- ROLEPLAY TAB: Senses · Talents · Mastery · Challenges --}}
<div class="jrpg-roleplay-wrap">

	{{!-- TOP ROW: Senses (left) + Mastery & Sparks (right) --}}
	<div class="jrpg-roleplay-top">

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Senses</div>
			{{#each system.attributes.sense as |sense key|}}
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.sense.{{key}}.value" data-label="{{key}}">{{key}}</span>
				<input type="text" name="system.attributes.sense.{{key}}.value" value="{{sense.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			{{/each}}
		</div>

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Mastery &amp; Sparks</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label">Mastery Points</span>
				<input type="number" name="system.masteryPoints.essence" value="{{system.masteryPoints.essence}}" data-dtype="Number" placeholder="0" min="0" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-sparks-row">
				<span class="jrpg-sparks-label">Sparks</span>
				<div class="jrpg-sparks-track">
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark1" {{checked system.sparks.spark1}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark2" {{checked system.sparks.spark2}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark3" {{checked system.sparks.spark3}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark4" {{checked system.sparks.spark4}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark5" {{checked system.sparks.spark5}}>
				</div>
			</div>
			<div class="jrpg-glory-row">
				<span class="jrpg-sparks-label">Glory Token</span>
				<label class="jrpg-glory-toggle {{#if system.gloryToken}}jrpg-glory-active{{/if}}" title="Double 6's — spend to add 1d6 to a Talent or Sense Check">
					<input type="checkbox" name="system.gloryToken" {{checked system.gloryToken}} style="display:none;">
					<span class="jrpg-glory-coin">
						<i class="fas fa-coins"></i>
					</span>
					<span class="jrpg-glory-label-text">{{#if system.gloryToken}}Token Ready{{else}}No Token{{/if}}</span>
				</label>
			</div>
		</div>

	</div>

	{{!-- TALENTS ROW: Physical · Mental · Social --}}
	<div class="jrpg-talents-grid">

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Physical</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.strength.value" data-label="Strength">Strength</span>
				<input type="text" name="system.attributes.talent.strength.value" value="{{system.attributes.talent.strength.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.nimbleness.value" data-label="Nimbleness">Nimbleness</span>
				<input type="text" name="system.attributes.talent.nimbleness.value" value="{{system.attributes.talent.nimbleness.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.finesse.value" data-label="Finesse">Finesse</span>
				<input type="text" name="system.attributes.talent.finesse.value" value="{{system.attributes.talent.finesse.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.endurance.value" data-label="Endurance">Endurance</span>
				<input type="text" name="system.attributes.talent.endurance.value" value="{{system.attributes.talent.endurance.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
		</div>

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Mental</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.wit.value" data-label="Wit">Wit</span>
				<input type="text" name="system.attributes.talent.wit.value" value="{{system.attributes.talent.wit.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.wisdom.value" data-label="Wisdom">Wisdom</span>
				<input type="text" name="system.attributes.talent.wisdom.value" value="{{system.attributes.talent.wisdom.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.survival.value" data-label="Survival">Survival</span>
				<input type="text" name="system.attributes.talent.survival.value" value="{{system.attributes.talent.survival.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
		</div>

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Social</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.aggression.value" data-label="Aggression">Aggression</span>
				<input type="text" name="system.attributes.talent.aggression.value" value="{{system.attributes.talent.aggression.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.deceit.value" data-label="Deceit">Deceit</span>
				<input type="text" name="system.attributes.talent.deceit.value" value="{{system.attributes.talent.deceit.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.diplomacy.value" data-label="Diplomacy">Diplomacy</span>
				<input type="text" name="system.attributes.talent.diplomacy.value" value="{{system.attributes.talent.diplomacy.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.intimacy.value" data-label="Intimacy">Intimacy</span>
				<input type="text" name="system.attributes.talent.intimacy.value" value="{{system.attributes.talent.intimacy.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.talent.charm.value" data-label="Charm">Charm</span>
				<input type="text" name="system.attributes.talent.charm.value" value="{{system.attributes.talent.charm.value}}" data-dtype="Number" class="jrpg-explore-input" />
			</div>
		</div>

	</div>

	{{!-- CHALLENGES --}}
	<div class="jrpg-explore-col jrpg-challenges-section">
		<div class="jrpg-explore-col-header">Challenges</div>
		<div class="jrpg-challenges-grid">

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Cooking</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="cooking">−</button>
					<input type="number" name="system.life.cooking.value" value="{{system.life.cooking.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="cooking">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Elixir Brewing</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="elixirbrewing">−</button>
					<input type="number" name="system.life.elixirbrewing.value" value="{{system.life.elixirbrewing.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="elixirbrewing">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Fishing</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="fishing">−</button>
					<input type="number" name="system.life.fishing.value" value="{{system.life.fishing.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="fishing">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Hunting</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="hunting">−</button>
					<input type="number" name="system.life.hunting.value" value="{{system.life.hunting.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="hunting">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Performing</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="performing">−</button>
					<input type="number" name="system.life.performing.value" value="{{system.life.performing.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="performing">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Scavenging</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="scavenging">−</button>
					<input type="number" name="system.life.scavenging.value" value="{{system.life.scavenging.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="scavenging">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Curse Breaking</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="cursebreaking">−</button>
					<input type="number" name="system.life.cursebreaking.value" value="{{system.life.cursebreaking.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="cursebreaking">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Coercing</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="coercing">−</button>
					<input type="number" name="system.life.coercing.value" value="{{system.life.coercing.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="coercing">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Dueling</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="dueling">−</button>
					<input type="number" name="system.life.dueling.value" value="{{system.life.dueling.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="dueling">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Taming</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="taming">−</button>
					<input type="number" name="system.life.taming.value" value="{{system.life.taming.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="taming">+</button>
				</div>
			</div>

		</div>
	</div>

	{{!-- BONDS --}}
	<ol class='items-list' style="margin-top: 10px;">
		<li class='item flexrow items-header'>
			<div class='item-name'>Bonds &nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
			<div class='item-armament-form'>Level</div>
			<div class='item-controls'>
				<a class='item-control item-create' title='Create bond' data-type='bonds'>
					<i class='fas fa-plus'></i> New
				</a>
			</div>
		</li>
		{{#each bonds as |item id|}}
		<li class='item flexrow' data-item-id='{{item._id}}'>
			<div class='item-name'>
				<div class='item-image'>
					<a class='rollable' data-roll-type='item'>
						<img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
					</a>
				</div>
				<h4>{{item.name}}</h4>
			</div>
			<div class='item-bond-levels item-prop'>{{system.bond.level}}</div>
			<div class='item-controls'>
				<a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
				<a class='item-control item-delete' title='Delete'><i class='fas fa-trash'></i></a>
			</div>
		</li>
		{{/each}}
	</ol>

</div>
