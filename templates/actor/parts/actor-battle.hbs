	{{!-- CHALLENGES --}}
	<div class="jrpg-explore-col jrpg-challenges-section">
		<div class="jrpg-explore-col-header">Challenges</div>
		<div class="jrpg-challenges-grid">

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Cooking</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="cooking">−</button>
					<input type="number" name="system.life.cooking.value" value="{{system.life.cooking.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="cooking">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Elixir Brewing</span>
				<div class="jrpg-challenge-controls">
					<button type="button" class="life-skill-btn minus jrpg-chal-btn" data-skill="elixirbrewing">−</button>
					<input type="number" name="system.life.elixirbrewing.value" value="{{system.life.elixirbrewing.value}}" min="0" max="5" readonly class="jrpg-challenge-val" />
					<button type="button" class="life-skill-btn plus jrpg-chal-btn" data-skill="elixirbrewing">+</button>
				</div>
			</div>

			<div class="jrpg-challenge-row">
				<span class="jrpg-challenge-label">Fishing</span>
