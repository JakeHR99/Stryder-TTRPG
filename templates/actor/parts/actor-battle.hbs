{{!-- ROLEPLAY TAB: Senses · Talents · Mastery · Challenges --}}
<div class="jrpg-roleplay-wrap">

	{{!-- TOP ROW: Senses (left) + Mastery & Sparks (right) --}}
	<div class="jrpg-roleplay-top">

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Senses</div>
			{{#each senseLayers as |L|}}
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label rollable" data-roll="2d6+@attributes.sense.{{L.key}}.value" data-label="{{L.key}}">{{L.key}}</span>
				<span class="jrpg-stat-controls">
					<button type="button" class="jrpg-stat-step" data-group="sense" data-stat="{{L.key}}" data-step="-1" title="Decrease your points">&minus;</button>
					<span class="jrpg-stat-total{{#if L.bonus}} has-folk{{/if}}" title="Total {{L.total}} — Folk/effect foundation +{{L.bonus}}, your points {{L.base}}">{{L.total}}</span>
					<button type="button" class="jrpg-stat-step" data-group="sense" data-stat="{{L.key}}" data-step="1" title="Increase your points">+</button>
				</span>
			</div>
			{{/each}}
		</div>

		<div class="jrpg-explore-col">
			<div class="jrpg-explore-col-header">Mastery &amp; Sparks</div>
			<div class="jrpg-explore-row">
				<span class="jrpg-explore-label">Mastery Points</span>
				<input type="number" name="system.masteryPoints.essence" value="{{system.masteryPoints.essence}}" data-dtype="Number" placeholder="0" min="0" class="jrpg-explore-input" />
			</div>
			<div class="jrpg-sparks-row">
				<span class="jrpg-sparks-label">Sparks</span>
				<div class="jrpg-sparks-track">
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark1" {{checked system.sparks.spark1}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark2" {{checked system.sparks.spark2}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark3" {{checked system.sparks.spark3}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark4" {{checked system.sparks.spark4}}>
					<input type="checkbox" class="jrpg-spark" name="system.sparks.spark5" {{checked system.sparks.spark5}}>
				</div>
			</div>
			<div class="jrpg-glory-row">
				<span class="jrpg-sparks-label">Glory Token</span>
				<label class="jrpg-glory-toggle {{#if system.gloryToken}}jrpg-glory-active{{/if}}" title="Double 6's — spend to add 1d6 to a Talent or Sense Check">
					<input type="checkbox" name="system.gloryToken" {{checked system.gloryToken}} style="display:none;">
					<span class="jrpg-glory-coin">
						<i class="fas fa-coins"></i>
					</span>
					<span class="jrpg-glory-label-text">{{#if system.gloryToken}}Token Ready{{else}}No Token{{/if}}</span>
				</label>
			</div>
		</div>

	</div>

	{{!-- TALENTS ROW: Physical · Mental · Social --}}
