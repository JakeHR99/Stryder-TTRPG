{{!-- Battle Tab --}}
<div class="jrpg-battle-wrap">

  {{!-- TOP RESOURCE STRIP --}}
  <div class="jrpg-battle-top">

  <div class="jrpg-battle-portrait-wrap">
    <div class="jrpg-battle-portrait-frame">
      <img src="{{actor.prototypeToken.texture.src}}" class="jrpg-battle-portrait-img" />
    </div>
  </div>

  <div class="jrpg-hud-res-area">
    <div class="jrpg-hud-res-row">
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label hp-label">HP</span>
        <input type="number" data-field="system.health.value" value="{{system.health.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max hp-label">{{system.health.max}}</span>
      </div>
      <div class="jrpg-hud-stat-divider"></div>
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label mp-label">MP</span>
        <div class="jrpg-res-sym jrpg-mp-sym"></div>
        <input type="number" data-field="system.mana.value" value="{{system.mana.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max mp-label">{{system.mana.max}}</span>
      </div>
      <div class="jrpg-hud-stat-divider"></div>
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label sta-label">STA</span>
        <div class="jrpg-res-sym jrpg-sta-sym"></div>
        <input type="number" data-field="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max sta-label">{{system.stamina.max}}</span>
      </div>
    </div>
    <div class="jrpg-hud-elixir-row">
      <span class="jrpg-battle-res-label sick-label">Elixir Sickness</span>
      <div class="jrpg-skull-pips" data-val="{{system.elixir_sickness.value}}"></div>
      <input type="number" name="system.elixir_sickness.value" value="{{system.elixir_sickness.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
    </div>
  </div>

  <div class="jrpg-hud-side-panel">
    <span class="jrpg-side-panel-label">Movement</span>
    <span class="jrpg-side-panel-val">{{system.attributes.move.running.value}}</span>
  </div>

  <div class="jrpg-hud-side-panel">
    <span class="jrpg-side-panel-label">Potency</span>
    <span class="jrpg-side-panel-val">{{system.attributes.physical_potency.value}}</span>
  </div>

  <div class="jrpg-battle-turn-btns">
    <span class="resource-button jrpg-battle-action-row" data-action="turnStart">Turn Start</span>
    <span class="resource-button jrpg-battle-action-row" data-action="combatEnd">Combat End</span>
  </div>

  </div>

  {{!-- ARMAMENT + BATTLE BAR --}}
  <div class="jrpg-battle-armament-bar">
    <div class="jrpg-battle-engage-row">

      <div class="jrpg-battle-left-btns">

        <div class="jrpg-form-select-wrap">
          <button type="button" class="jrpg-form-select-btn" data-action="toggleFormDropdown">
            <span class="jrpg-form-select-icon">⚔</span>
            <span class="jrpg-form-select-label">Loading…</span>
          </button>
          <div class="jrpg-form-dropdown" id="jrpg-form-dropdown"></div>
        </div>

        <button type="button" class="jrpg-aspect-select-btn" data-action="openAspectSelect">
          <span class="jrpg-aspect-select-icon">✦</span>
          <span class="jrpg-aspect-select-label">Select Aspect</span>
        </button>

      </div>

      <button type="button" class="resource-button jrpg-battle-engage-btn" data-action="battleEngage">
        ⚔ Battle!
      </button>

    </div>
  </div>

  {{!-- MID GRID: Skills (left) + Defense (right) --}}
  <div class="jrpg-battle-mid-grid">

    {{!-- Skills --}}
    <div class="jrpg-battle-col">
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>Skills & Attacks &nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
          <div class='item-controls'>
            <a class='item-control item-create' title='Add Skill' data-type='skill'>
              <i class='fas fa-plus magical-icon'></i> New
            </a>
          </div>
        </li>
        {{#each skills as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable magical-icon' data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
            {{#if (gt item.system.cooldown_value 0)}}
              <span class="item-limit-counter" data-item-id="{{item._id}}">
                {{#if (ne item.system.uses_current undefined)}}{{item.system.uses_current}}{{else}}{{item.system.cooldown_value}}{{/if}}/{{item.system.cooldown_value}}
              </span>
            {{/if}}
          </div>
          <div class='item-controls'>
            <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
            <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
            <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
          </div>
        </li>
        {{/each}}
        {{#each actions as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable magical-icon' data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
            {{#if (gt item.system.limit.max 0)}}
              <span class="item-limit-counter" data-item-id="{{item._id}}">{{item.system.limit.value}}/{{item.system.limit.max}}</span>
            {{/if}}
          </div>
          <div class='item-controls'>
            <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
            <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
            <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

    {{!-- Defense Panel --}}
    <div class="jrpg-battle-col">
      <div class="jrpg-defense-panel">
        <div class="jrpg-defense-header">Defense</div>
        <div class="jrpg-defense-grid">
          <span class="jrpg-defense-row rollable" data-custom-roll="1d6+@abilities.Reflex.value+@reflex_tag.bonus" data-label="Dodge Roll">Dodge</span>
          <span class="jrpg-defense-row rollable" data-custom-roll="2d6+@abilities.Reflex.value+@reflex_tag.bonus" data-label="Evade Roll">Evade</span>
          <span class="jrpg-defense-row rollable" data-roll="2d6+@abilities.Will.value+@checks.Magykal.mod" data-label="Magykal Resistance Check">M. Resist</span>
          <span class="jrpg-defense-row rollable" data-roll="2d6+@abilities.Grit.value+@checks.Physical.mod" data-label="Physical Resistance Check">P. Resist</span>
        </div>
      </div>
    </div>

  </div>

  {{!-- LOWER GRID: Folk Abilities / Class Features / Techniques (right only) --}}
  <div class="jrpg-battle-mid-grid">

    {{!-- left col intentionally empty --}}
    <div class="jrpg-battle-col"></div>

    {{!-- Folk Abilities + Class Features + Techniques --}}
    <div class="jrpg-battle-col">
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>{{localize 'Folk Abilities'}} &nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
          <div class='item-controls'>
            <a class='item-control item-create' title='Create item' data-type='racial'>
              <i class='fas fa-plus magical-icon'></i> New
            </a>
          </div>
        </li>
        {{#each racials as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable magical-icon' data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class='item-folk-uses item-prop'>
            {{#if (gt item.system.cooldown_value 0)}}
              <div class='uses-container'>
                <button type='button' class='uses-reset-btn' data-item-id='{{item._id}}' title='Reset uses'>
                  <i class='fas fa-redo'></i>
                </button>
                <input type='number'
                       class='uses-current'
                       value='{{#if (ne item.system.uses_current undefined)}}{{item.system.uses_current}}{{else}}{{item.system.cooldown_value}}{{/if}}'
                       data-item-id='{{item._id}}'
                       data-field='uses_current' />
                <span class='uses-separator'>/</span>
                <span class='uses-max'>{{item.system.cooldown_value}}</span>
              </div>
            {{/if}}
          </div>
          <div class='item-controls'>
            <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
            <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
            <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>{{localize 'Class Features'}} &nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
          <div class='item-controls'>
            <a class='item-control item-create' title='Create item' data-type='feature'>
              <i class='fas fa-plus magical-icon'></i> New
            </a>
          </div>
        </li>
        {{#each features as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable magical-icon' data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class='item-controls'>
            <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
            <a class='item-control item-edit magical-icon' title='{{localize "DOCUMENT.Edit" type="feature"}}'><i class='fas fa-edit'></i></a>
            <a class='item-control item-delete magical-icon' title='{{localize "DOCUMENT.Delete" type="feature"}}'><i class='fas fa-trash'></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      <ol class='items-list'>
        <li class='item flexrow items-header'>
          <div class='item-name'>{{localize 'Techniques'}} &nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
          <div class='item-controls'>
            <a class='item-control item-create' title='Create item' data-type='technique'>
              <i class='fas fa-plus magical-icon'></i> New
            </a>
          </div>
        </li>
        {{#each techniques as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable magical-icon' data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class='item-controls'>
            <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
            <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
            <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>

  </div>


</div>
