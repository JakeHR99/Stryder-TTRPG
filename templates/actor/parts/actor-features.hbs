{{!-- Battle Tab --}}
<div class="jrpg-battle-wrap">

  {{!-- TOP RESOURCE STRIP --}}
  <div class="jrpg-battle-top">

  <div class="jrpg-battle-portrait-wrap">
    <div class="jrpg-battle-portrait-frame">
      <img src="{{actor.prototypeToken.texture.src}}" class="jrpg-battle-portrait-img" />
    </div>
  </div>

  <div class="jrpg-hud-res-area">
    <div class="jrpg-hud-res-row">
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label hp-label">HP</span>
        <input type="number" data-field="system.health.value" value="{{system.health.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max hp-label">{{system.health.max}}</span>
      </div>
      <div class="jrpg-hud-stat-divider"></div>
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label mp-label">MP</span>
        <div class="jrpg-res-sym jrpg-mp-sym"></div>
        <input type="number" data-field="system.mana.value" value="{{system.mana.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max mp-label">{{system.mana.max}}</span>
      </div>
      <div class="jrpg-hud-stat-divider"></div>
      <div class="jrpg-hud-stat">
        <span class="jrpg-battle-res-label sta-label">STA</span>
        <div class="jrpg-res-sym jrpg-sta-sym"></div>
        <input type="number" data-field="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
        <span class="jrpg-battle-res-sep">/</span>
        <span class="jrpg-battle-res-max sta-label">{{system.stamina.max}}</span>
      </div>
    </div>
    <div class="jrpg-hud-elixir-row">
      <span class="jrpg-battle-res-label sick-label">Elixir Sickness</span>
      <div class="jrpg-skull-pips" data-val="{{system.elixir_sickness.value}}"></div>
      <input type="number" name="system.elixir_sickness.value" value="{{system.elixir_sickness.value}}" data-dtype="Number" class="jrpg-battle-res-num" />
    </div>
  </div>

  <div class="jrpg-hud-side-panel">
    <span class="jrpg-side-panel-label">Movement</span>
    <span class="jrpg-side-panel-val">{{system.attributes.move.running.value}}</span>
  </div>

  <div class="jrpg-hud-side-panel">
    <span class="jrpg-side-panel-label">Potency</span>
    <span class="jrpg-side-panel-val">{{system.attributes.physical_potency.value}}</span>
  </div>

  {{!-- Flow counter — only shown when actor has Discipline --}}
  {{#if flags.stryder.flow}}
  <div class="jrpg-hud-side-panel jrpg-flow-panel">
    <span class="jrpg-side-panel-label">Flow</span>
    <span class="jrpg-side-panel-val jrpg-flow-val">{{flags.stryder.flow}}</span>
  </div>
  {{/if}}

  {{!-- Ichor counter — only shown when Brutality is the active Aspect --}}
  {{#if isBrutalityActive}}
  <div class="jrpg-hud-side-panel jrpg-ichor-panel">
    <span class="jrpg-side-panel-label ichor-label">Ichor</span>
    <div class="jrpg-ichor-stepper">
      <button type="button" class="jrpg-ichor-btn resource-button" data-action="ichorDecrement">−</button>
      <span class="jrpg-side-panel-val jrpg-ichor-val">{{flags.stryder.ichor}}</span>
      <button type="button" class="jrpg-ichor-btn resource-button" data-action="ichorIncrement">+</button>
    </div>
    <span class="jrpg-ichor-max">/8</span>
  </div>
  {{/if}}

  {{!-- Warlock resource panels — Bloodloss (Max HP paid) and Manaburn --}}
  {{#if isWarlockClass}}
  <div class="jrpg-hud-side-panel jrpg-bloodloss-panel" title="Maximum Health currently paid as Bloodloss — restored at the end of the engagement (heal for half)">
    <span class="jrpg-side-panel-label bloodloss-label">Bloodloss</span>
    <div class="jrpg-ichor-stepper">
      <button type="button" class="jrpg-bloodloss-btn resource-button" data-action="bloodlossDecrement">−</button>
      <span class="jrpg-side-panel-val jrpg-bloodloss-val">{{warlockBloodloss}}</span>
      <button type="button" class="jrpg-bloodloss-btn resource-button" data-action="bloodlossIncrement">+</button>
    </div>
  </div>
  <div class="jrpg-hud-side-panel jrpg-manaburn-panel" title="Manaburn — +1 per Mana expended; all of it is lost at the start of the following Phase">
    <span class="jrpg-side-panel-label manaburn-label">Manaburn</span>
    <div class="jrpg-ichor-stepper">
      <button type="button" class="jrpg-manaburn-btn resource-button" data-action="manaburnDecrement">−</button>
      <span class="jrpg-side-panel-val jrpg-manaburn-val">{{warlockManaburn}}</span>
      <button type="button" class="jrpg-manaburn-btn resource-button" data-action="manaburnIncrement">+</button>
    </div>
  </div>
  {{/if}}

  <div class="jrpg-battle-turn-btns">
    <span class="resource-button jrpg-battle-action-row" data-action="turnStart">Turn Start</span>
    <span class="resource-button jrpg-battle-action-row" data-action="combatEnd">Combat End</span>
  </div>

  </div>

  {{!-- ARMAMENT + BATTLE BAR --}}
  <div class="jrpg-battle-armament-bar">
    <div class="jrpg-battle-engage-row">

      <div class="jrpg-battle-left-btns">

        <div class="jrpg-form-select-wrap">
          <button type="button" class="jrpg-form-select-btn" data-action="toggleFormDropdown">
            <span class="jrpg-form-select-icon">⚔</span>
            <span class="jrpg-form-select-label">Loading…</span>
          </button>
          <div class="jrpg-form-dropdown" id="jrpg-form-dropdown"></div>
        </div>

        <button type="button" class="jrpg-aspect-select-btn" data-action="openAspectSelect">
          <span class="jrpg-aspect-select-icon">✦</span>
          <span class="jrpg-aspect-select-label">{{#if activeAspectLabel}}{{activeAspectLabel}}{{else}}Select Aspect{{/if}}</span>
        </button>

      </div>

      <div class="jrpg-battle-right-btns">
        <button type="button" class="resource-button jrpg-battle-engage-btn" data-action="battleEngage">
          ⚔ Battle!
        </button>
        <button type="button" class="jrpg-focused-atk-btn" data-action="focusedAttack">
          ⚔ Focused Attack
        </button>
      </div>

    </div>
  </div>

  {{!-- CONTENT GRID: single two-column layout so left column is one continuous stack --}}
  <div class="jrpg-battle-mid-grid">

    {{!-- LEFT COLUMN: Skills + Folk + Class + Techniques --}}
    <div class="jrpg-battle-col">
      <details class="stryder-section" open>
        <summary class="stryder-section-header">
          <span class="stryder-section-chevron">▾</span>
          <span class='stryder-section-title'>Skills &amp; Attacks</span>
          <a class='item-control item-create stryder-section-new' title='Add Skill' data-type='skill'>+ New</a>
        </summary>
        <ol class='items-list'>
          {{#each skills as |item id|}}
          <li class='item flexrow stryder-skill-row' data-item-id='{{item._id}}'>
            <a class='skill-favorite-toggle {{#if (lookup ../favorites item._id)}}is-favorited{{/if}}' data-item-id='{{item._id}}' title='Favorite for battle'>
              <i class='{{#if (lookup ../favorites item._id)}}fas fa-star{{else}}far fa-star{{/if}}'></i>
            </a>
            <h4 class='rollable magical-icon stryder-skill-name' data-roll-type='item'>{{item.name}}</h4>
            <div class='stryder-skill-costs'>
              {{#if (gt item.system.stamina_cost 0)}}
              <div class='stryder-cost-pill stryder-cost-sta'>
                <div class='jrpg-res-sym jrpg-sta-sym stryder-cost-sym'></div>
                <span>×{{item.system.stamina_cost}}</span>
              </div>
              {{/if}}
              {{#if (gt item.system.mana_cost 0)}}
              <div class='stryder-cost-pill stryder-cost-mp'>
                <div class='jrpg-res-sym jrpg-mp-sym stryder-cost-sym'></div>
                <span>×{{item.system.mana_cost}}</span>
              </div>
              {{/if}}
            </div>
            <div class='stryder-skill-limit'>
              {{#if (gt item.system.cooldown_value 0)}}
                <span class="stryder-limit-badge">{{#if (ne item.system.uses_current undefined)}}{{item.system.uses_current}}{{else}}{{item.system.cooldown_value}}{{/if}}/{{item.system.cooldown_value}}</span>
              {{else}}
                <span class="stryder-limit-badge stryder-limit-inf">∞</span>
              {{/if}}
            </div>
            <div class='item-controls'>
              <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
              <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
              <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
            </div>
          </li>
          {{/each}}
          {{#each aspectAbilities as |item id|}}
          <li class='item flexrow stryder-skill-row' data-item-id='{{item._id}}' data-active-aspect='{{item.isActiveAspect}}'>
            <a class='skill-favorite-toggle {{#if (lookup ../favorites item._id)}}is-favorited{{/if}}' data-item-id='{{item._id}}' title='Favorite for battle'>
              <i class='{{#if (lookup ../favorites item._id)}}fas fa-star{{else}}far fa-star{{/if}}'></i>
            </a>
            <h4 class='rollable magical-icon stryder-skill-name' data-roll-type='item'>{{item.name}}</h4>
            <div class='stryder-skill-costs'>
              {{#if (gt item.system.stamina_cost 0)}}
              <div class='stryder-cost-pill stryder-cost-sta'>
                <div class='jrpg-res-sym jrpg-sta-sym stryder-cost-sym'></div>
                <span>×{{item.system.stamina_cost}}</span>
              </div>
              {{/if}}
              {{#if (gt item.system.mana_cost 0)}}
              <div class='stryder-cost-pill stryder-cost-mp'>
                <div class='jrpg-res-sym jrpg-mp-sym stryder-cost-sym'></div>
                <span>×{{item.system.mana_cost}}</span>
              </div>
              {{/if}}
            </div>
            <div class='stryder-skill-limit'>
              {{#if (gt item.system.limit.max 0)}}
                <span class="stryder-limit-badge">{{item.system.limit.value}}/{{item.system.limit.max}}</span>
              {{else}}
                <span class="stryder-limit-badge stryder-limit-inf">∞</span>
              {{/if}}
            </div>
            <div class='item-controls'>
              <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
              <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
              <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </details>
      {{!-- Folk Abilities + Class Features + Techniques --}}
      <details class="stryder-section" open>
        <summary class="stryder-section-header">
          <span class="stryder-section-chevron">▾</span>
          <span class='stryder-section-title'>{{localize 'Folk Abilities'}}</span>
          <a class='item-control item-create stryder-section-new' title='Create item' data-type='racial'>+ New</a>
        </summary>
        <ol class='items-list'>
          {{#each racials as |item id|}}
          <li class='item flexrow' data-item-id='{{item._id}}'>
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable magical-icon' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
                </a>
              </div>
              <h4>{{item.name}}</h4>
            </div>
            <div class='item-folk-uses item-prop'>
              {{#if (gt item.system.cooldown_value 0)}}
                <div class='uses-container'>
                  <button type='button' class='uses-reset-btn' data-item-id='{{item._id}}' title='Reset uses'>
                    <i class='fas fa-redo'></i>
                  </button>
                  <input type='number'
                         class='uses-current'
                         value='{{#if (ne item.system.uses_current undefined)}}{{item.system.uses_current}}{{else}}{{item.system.cooldown_value}}{{/if}}'
                         data-item-id='{{item._id}}'
                         data-field='uses_current' />
                  <span class='uses-separator'>/</span>
                  <span class='uses-max'>{{item.system.cooldown_value}}</span>
                </div>
              {{/if}}
            </div>
            <div class='item-controls'>
              <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
              <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
              <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </details>
      <details class="stryder-section" open>
        <summary class="stryder-section-header">
          <span class="stryder-section-chevron">▾</span>
          <span class='stryder-section-title'>{{localize 'Class Features'}}</span>
          <a class='item-control item-create stryder-section-new' title='Create item' data-type='feature'>+ New</a>
        </summary>
        <ol class='items-list'>
          {{#each features as |item id|}}
          <li class='item flexrow' data-item-id='{{item._id}}'>
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable magical-icon' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
                </a>
              </div>
              <h4>{{item.name}}</h4>
            </div>
            <div class='item-controls'>
              <a class='item-control item-duplicate' title='Duplicate'><i class='fas fa-copy'></i></a>
              <a class='item-control item-edit magical-icon' title='{{localize "DOCUMENT.Edit" type="feature"}}'><i class='fas fa-edit'></i></a>
              <a class='item-control item-delete magical-icon' title='{{localize "DOCUMENT.Delete" type="feature"}}'><i class='fas fa-trash'></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </details>
      <details class="stryder-section" open>
        <summary class="stryder-section-header">
          <span class="stryder-section-chevron">▾</span>
          <span class='stryder-section-title'>Techniques</span>
        </summary>
        <ol class='items-list'>
          {{#each techniques as |item id|}}
          <li class='item flexrow stryder-skill-row' data-item-id='{{item._id}}'>
            <h4 class='rollable magical-icon stryder-skill-name' data-roll-type='item'>{{item.name}}</h4>
            <span class='stryder-upa-type'>{{item.system.action_type}}</span>
            <div class='stryder-skill-limit'>
              {{#if (gt item.system.limit.max 0)}}
                <span class="stryder-limit-badge">{{item.system.limit.value}}/{{item.system.limit.max}}</span>
              {{else}}
                <span class="stryder-limit-badge stryder-limit-inf">∞</span>
              {{/if}}
            </div>
            <div class='item-controls'>
              <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
              <a class='item-control item-delete magical-icon' title='Delete'><i class='fas fa-trash'></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </details>
    </div>

    {{!-- RIGHT COLUMN: Defense + Player Actions --}}
    <div class="jrpg-battle-col">
      <div class="jrpg-defense-panel">
        <div class="jrpg-defense-header">Defense</div>
        <div class="jrpg-defense-grid">
          <span class="jrpg-defense-row rollable" data-custom-roll="1d6+@abilities.Reflex.value+@reflex_tag.bonus" data-label="Dodge Roll">Dodge</span>
          <span class="jrpg-defense-row rollable" data-custom-roll="2d6+@abilities.Reflex.value+@reflex_tag.bonus" data-label="Evade Roll">Evade</span>
          <span class="jrpg-defense-row rollable" data-roll="2d6+@abilities.Will.value+@checks.Magykal.mod" data-label="Magykal Resistance Check">M. Resist</span>
          <span class="jrpg-defense-row rollable" data-roll="2d6+@abilities.Grit.value+@checks.Physical.mod" data-label="Physical Resistance Check">P. Resist</span>
        </div>
      </div>
      <details class="stryder-section" open style="margin-top:8px;">
        <summary class="stryder-section-header">
          <span class="stryder-section-chevron">▾</span>
          <span class='stryder-section-title'>Player Actions</span>
        </summary>
        <ol class='items-list'>
          {{#each playerActions as |item id|}}
          <li class='item flexrow stryder-upa-row' data-item-id='{{item._id}}'>
            <a class='skill-favorite-toggle {{#if (lookup ../favorites item._id)}}is-favorited{{/if}}' data-item-id='{{item._id}}' title='Favorite for battle'>
              <i class='{{#if (lookup ../favorites item._id)}}fas fa-star{{else}}far fa-star{{/if}}'></i>
            </a>
            <h4 class='rollable magical-icon stryder-upa-name' data-roll-type='item'>{{item.name}}</h4>
            <span class='stryder-upa-type'>{{item.system.action_type}}</span>
            <div class='stryder-upa-cost-slot'>
              {{#if (gt item.system.stamina_cost 0)}}
              <div class='stryder-cost-pill stryder-cost-sta'>
                <div class='jrpg-res-sym jrpg-sta-sym stryder-cost-sym'></div>
                <span>×{{item.system.stamina_cost}}</span>
              </div>
              {{/if}}
            </div>
            <div class='item-controls'>
              <a class='item-control item-edit magical-icon' title='Edit'><i class='fas fa-edit'></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
      </details>
    </div>

  </div>


</div>
