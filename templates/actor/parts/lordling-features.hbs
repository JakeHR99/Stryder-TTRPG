{{!-- LORDLING FEATURES — dark JRPG style --}}
<style>
.lrd-items-section { margin-bottom: 10px; }
.lrd-items-header {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px;
  background: rgba(12,20,55,0.7);
  border: 1px solid rgba(45,70,170,0.25);
  border-radius: 4px 4px 0 0;
  cursor: pointer;
  user-select: none;
}
.lrd-items-header-title {
  font-family: 'Cinzel', serif;
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(130,165,225,0.65);
  flex: 1;
}
.lrd-items-header-new {
  font-family: 'Rajdhani', sans-serif;
  font-size: 11px;
  color: rgba(100,140,210,0.5);
  background: transparent;
  border: 1px solid rgba(50,80,180,0.2);
  border-radius: 3px;
  padding: 1px 7px;
  cursor: pointer;
  transition: background 0.12s, color 0.12s;
}
.lrd-items-header-new:hover { background: rgba(30,55,140,0.4); color: rgba(160,200,255,0.9); }

.lrd-items-list { border: 1px solid rgba(40,65,160,0.2); border-top: none; border-radius: 0 0 4px 4px; }

.lrd-item-row {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 8px;
  border-bottom: 1px solid rgba(35,55,140,0.15);
  transition: background 0.1s;
}
.lrd-item-row:last-child { border-bottom: none; }
.lrd-item-row:hover { background: rgba(18,32,90,0.3); }

.lrd-item-img {
  width: 22px; height: 22px;
  border-radius: 3px;
  border: 1px solid rgba(50,80,180,0.2);
  object-fit: cover;
  flex-shrink: 0;
  cursor: pointer;
  transition: border-color 0.15s;
}
.lrd-item-img:hover { border-color: rgba(100,150,240,0.6); }

.lrd-item-name {
  font-family: 'Rajdhani', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: rgba(195,215,255,0.85);
  flex: 1;
  cursor: pointer;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lrd-item-name:hover { color: rgba(230,240,255,0.95); }

.lrd-item-tag {
  font-family: 'Rajdhani', sans-serif;
  font-size: 10px;
  color: rgba(100,135,205,0.45);
  letter-spacing: .04em;
  flex-shrink: 0;
}

.lrd-item-controls { display: flex; gap: 4px; flex-shrink: 0; }
.lrd-item-ctrl {
  width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  color: rgba(90,120,200,0.4);
  cursor: pointer;
  border-radius: 2px;
  font-size: 11px;
  transition: color 0.12s, background 0.12s;
  border: none; background: transparent;
}
.lrd-item-ctrl:hover { color: rgba(160,195,255,0.85); background: rgba(30,55,140,0.3); }
.lrd-item-ctrl.delete:hover { color: rgba(220,80,80,0.85); background: rgba(100,20,20,0.25); }

.lrd-empty {
  padding: 10px 12px;
  font-family: 'Rajdhani', sans-serif;
  font-size: 11px;
  color: rgba(90,115,180,0.4);
  font-style: italic;
  text-align: center;
  border: 1px solid rgba(40,65,160,0.15);
  border-top: none;
  border-radius: 0 0 4px 4px;
}
</style>

{{!-- ── Lordly Aspect Features (actions with isLordlyFeature flag) ── --}}
<div class="lrd-items-section">
  <div class="lrd-items-header">
    <span class="lrd-items-header-title">Lordly Features</span>
    <a class="lrd-items-header-new item-control item-create" title="Create" data-type="action">+ New</a>
  </div>
  {{#if actions.length}}
  <div class="lrd-items-list">
    {{#each actions as |item id|}}
    <div class="lrd-item-row" data-item-id="{{item._id}}">
      <a class="rollable" data-roll-type="item">
        <img class="lrd-item-img" src="{{item.img}}" title="{{item.name}}" />
      </a>
      <span class="lrd-item-name rollable" data-roll-type="item">{{item.name}}</span>
      <span class="lrd-item-tag">{{item.system.action_type}}</span>
      <div class="lrd-item-controls">
        <a class="lrd-item-ctrl item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="lrd-item-ctrl delete item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="lrd-empty">No features yet — acquire Lordly Aspect Features from the Shaman's Growth menu.</div>
  {{/if}}
</div>

{{!-- ── Generic Attacks ── --}}
{{#if generic.length}}
<div class="lrd-items-section">
  <div class="lrd-items-header">
    <span class="lrd-items-header-title">Generic Attacks</span>
    <a class="lrd-items-header-new item-control item-create" title="Create" data-type="generic">+ New</a>
  </div>
  <div class="lrd-items-list">
    {{#each generic as |item id|}}
    <div class="lrd-item-row" data-item-id="{{item._id}}">
      <a class="rollable" data-roll-type="item">
        <img class="lrd-item-img" src="{{item.img}}" title="{{item.name}}" />
      </a>
      <span class="lrd-item-name rollable" data-roll-type="item">{{item.name}}</span>
      <div class="lrd-item-controls">
        <a class="lrd-item-ctrl item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="lrd-item-ctrl delete item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </div>
    {{/each}}
  </div>
</div>
{{/if}}

{{!-- ── Passives ── --}}
{{#if passive.length}}
<div class="lrd-items-section">
  <div class="lrd-items-header">
    <span class="lrd-items-header-title">Passives</span>
    <a class="lrd-items-header-new item-control item-create" title="Create" data-type="passive">+ New</a>
  </div>
  <div class="lrd-items-list">
    {{#each passive as |item id|}}
    <div class="lrd-item-row" data-item-id="{{item._id}}">
      <a class="rollable" data-roll-type="item">
        <img class="lrd-item-img" src="{{item.img}}" title="{{item.name}}" />
      </a>
      <span class="lrd-item-name rollable" data-roll-type="item">{{item.name}}</span>
      <div class="lrd-item-controls">
        <a class="lrd-item-ctrl item-edit" title="Edit"><i class="fas fa-edit"></i></a>
        <a class="lrd-item-ctrl delete item-delete" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
    </div>
    {{/each}}
  </div>
</div>
{{/if}}
