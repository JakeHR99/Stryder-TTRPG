<div class="spirit-beast-abilities" style="padding: 10px;">

  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>Abilities&nbsp;<i class='toggle-icon fas fa-chevron-down'></i></div>
      <div class='item-action-type'>Type</div>
      <div class='item-controls'>
        {{#if editable}}
        <a class='item-control item-create' title='Add Ability' data-type='action'>
          <i class='fas fa-plus'></i>
        </a>
        {{/if}}
      </div>
    </li>
    {{#each actions as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img src='{{item.img}}' title='{{item.name}}' width='24' height='24'/>
            </a>
          </div>
          <h4>{{item.name}}</h4>
        </div>
        <div class='item-action-type item-prop'>{{item.system.action_type}}</div>
        <div class='item-controls'>
          {{#if ../editable}}
          <a class='item-control item-edit' title='Edit'><i class='fas fa-edit'></i></a>
          <a class='item-control item-delete' title='Delete'><i class='fas fa-trash'></i></a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

  <div style="margin-top: 16px; background-image: url('systems/stryder/assets/parchment.jpg'); background-size: cover; padding: 10px; border: 1px solid #c9a66b; border-radius: 6px; font-style: italic; font-size: 12px; color: #555;">
    <strong>Resistances:</strong> Spirit Beasts use their Summoner's Resistances when rolling Resistance. Spirit Beasts gain +3 when rolling to Resist [Magykal] abilities.
  </div>

</div>
