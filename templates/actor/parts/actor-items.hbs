{{!-- ======================================================
     GEAR INVENTORY GRID
     ====================================================== --}}
<div class="jrpg-inventory-wrap" style="display:flex;flex-direction:column;gap:8px;padding:12px;width:100%;box-sizing:border-box;">

  <div class="jrpg-inv-header">
    <span class="jrpg-inv-title">INVENTORY</span>
    <span class="jrpg-inv-capacity {{#if inventoryFull}}inv-full{{/if}}">
      {{inventoryUsed}} / {{inventoryMax}} slots
    </span>
  </div>

  <div class="jrpg-inv-body">
  <div class="jrpg-inv-grid" data-drop-zone="inventory" style="display:grid !important;grid-template-columns:repeat(8,1fr);gap:6px;flex:1 1 auto;min-width:0;align-content:start;box-sizing:border-box;">
    {{#each inventoryGrid}}
      {{#if this.empty}}
        <div class="inv-slot inv-empty" data-slot-id="{{this.id}}" data-slot-index="{{this.slotIndex}}" data-action="addItemFromSlot" style="cursor:pointer;aspect-ratio:1/1;min-width:0;overflow:hidden;background:rgba(8,14,35,0.6);border:1px solid rgba(60,90,160,0.18);border-radius:5px;display:flex;align-items:center;justify-content:center;transition:background 0.18s ease,border-color 0.18s ease,box-shadow 0.18s ease;"></div>
      {{else}}
        <div class="inv-slot inv-item
          {{#if this.isSolo}}inv-solo{{/if}}
          {{#if this.isStart}}inv-start{{/if}}
          {{#if this.isMid}}inv-mid{{/if}}
          {{#if this.isEnd}}inv-end{{/if}}"
          data-item-id="{{this.itemId}}"
          data-slot-id="{{this.id}}"
          data-slot-index="{{this.slotIndex}}"
          {{#if this.clickable}}data-clickable="true"{{/if}}
          title="{{this.itemName}} ({{this.itemSize}} slot{{#if (gt this.itemSize 1)}}s{{/if}})"
          style="aspect-ratio:1/1;min-width:0;overflow:hidden;display:flex;align-items:center;justify-content:center;transition:box-shadow 0.18s ease,filter 0.18s ease;">
          {{#if this.showIcon}}
            {{#if this.itemImg}}
              <img class="inv-item-img" src="{{this.itemImg}}" alt="{{this.itemName}}" style="width:65%;height:65%;object-fit:contain;max-width:100%;max-height:100%;">
            {{else}}
              <i class="fas fa-box inv-item-icon"></i>
            {{/if}}
          {{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>

  {{!-- ── EQUIPMENT LOADOUT — CSS silhouette + typed slots ── --}}
  <div class="jrpg-equip-panel">
    <div class="jrpg-equip-title">EQUIPMENT</div>
    <div class="jrpg-equip-body">
      <div class="jrpg-equip-figure">
        <img class="equip-figure-img" src="{{equipImg}}" alt="{{actor.name}}" style="transform: translateY({{equipImgY}}%) scale({{equipImgScaleCss}});" />
        {{#if bioIsEditor}}
        <button type="button" class="jrpg-bio-portrait-pick equip-figure-pick" data-action="bioPickImage" data-target="flags.stryder.equipImg" title="Choose the figure image for this panel">✎</button>
        <input type="range" class="equip-figure-ypos" min="-40" max="60" step="2" value="{{equipImgY}}" title="Figure vertical position" />
        <input type="range" class="equip-figure-scale" min="50" max="250" step="5" value="{{equipImgScale}}" title="Figure size" />
        {{/if}}
      </div>
      <div class="equip-rail">
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.head}}equip-filled{{/if}}" data-equip-slot="head" data-equip-type="head" {{#if equipment.head}}data-item-id="{{equipment.head._id}}"{{/if}} data-tooltip="{{#if equipment.head}}Head — {{equipment.head.name}}{{else}}Head — empty{{/if}}">
            {{#if equipment.head}}<img src="{{equipment.head.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Head</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.torso}}equip-filled{{/if}}" data-equip-slot="torso" data-equip-type="back" {{#if equipment.torso}}data-item-id="{{equipment.torso._id}}"{{/if}} data-tooltip="{{#if equipment.torso}}Torso — {{equipment.torso.name}}{{else}}Torso — empty{{/if}}">
            {{#if equipment.torso}}<img src="{{equipment.torso.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Torso</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.arms1}}equip-filled{{/if}}" data-equip-slot="arms1" data-equip-type="arms" {{#if equipment.arms1}}data-item-id="{{equipment.arms1._id}}"{{/if}} data-tooltip="{{#if equipment.arms1}}Arm — {{equipment.arms1.name}}{{else}}Arm — empty{{/if}}">
            {{#if equipment.arms1}}<img src="{{equipment.arms1.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Arm</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.arms2}}equip-filled{{/if}}" data-equip-slot="arms2" data-equip-type="arms" {{#if equipment.arms2}}data-item-id="{{equipment.arms2._id}}"{{/if}} data-tooltip="{{#if equipment.arms2}}Arm — {{equipment.arms2.name}}{{else}}Arm — empty{{/if}}">
            {{#if equipment.arms2}}<img src="{{equipment.arms2.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Arm</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.gems1}}equip-filled{{/if}}" data-equip-slot="gems1" data-equip-type="gems" {{#if equipment.gems1}}data-item-id="{{equipment.gems1._id}}"{{/if}} data-tooltip="{{#if equipment.gems1}}Gem — {{equipment.gems1.name}}{{else}}Gem — empty{{/if}}">
            {{#if equipment.gems1}}<img src="{{equipment.gems1.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Gem</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.gems2}}equip-filled{{/if}}" data-equip-slot="gems2" data-equip-type="gems" {{#if equipment.gems2}}data-item-id="{{equipment.gems2._id}}"{{/if}} data-tooltip="{{#if equipment.gems2}}Gem — {{equipment.gems2.name}}{{else}}Gem — empty{{/if}}">
            {{#if equipment.gems2}}<img src="{{equipment.gems2.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Gem</span>
        </div>
        <div class="equip-box-wrap">
          <div class="equip-slot {{#if equipment.legs}}equip-filled{{/if}}" data-equip-slot="legs" data-equip-type="legs" {{#if equipment.legs}}data-item-id="{{equipment.legs._id}}"{{/if}} data-tooltip="{{#if equipment.legs}}Legs — {{equipment.legs.name}}{{else}}Legs — empty{{/if}}">
            {{#if equipment.legs}}<img src="{{equipment.legs.img}}" alt="" /><button type="button" class="equip-unequip" title="Unequip">✕</button>{{/if}}
          </div>
          <span class="equip-box-label">Legs</span>
        </div>
      </div>
    </div>
    <div class="jrpg-equip-totals" title="Total reduction from equipped gear">
      <span class="equip-total-phys">⛨ {{equipTotals.phys}} Physical</span>
      <span class="equip-total-mag">✦ {{equipTotals.magykal}} Magykal</span>
    </div>
  </div>
  </div>

  {{!-- ── Essence currency (brewing) — placeholder tracker; move to a real currency bar later ── --}}
  <div class="jrpg-inv-currency" style="display:flex;align-items:center;justify-content:center;gap:10px;margin-top:2px;padding:8px 14px;background:rgba(8,14,35,0.6);border:1px solid rgba(60,90,160,0.25);border-radius:6px;box-sizing:border-box;">
    <span style="width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 36% 32%, #bfe0ff, #2f7ff0 62%, #184fb0);box-shadow:0 0 8px rgba(90,160,255,0.6);flex-shrink:0;"></span>
    <span style="font-family:'Rajdhani',sans-serif;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#a9b6d6;">Essence</span>
    <input type="number" name="system.essence" value="{{system.essence}}" data-dtype="Number" min="0" placeholder="0"
      style="width:84px;text-align:center;background:rgba(6,14,28,0.8);border:1px solid rgba(120,170,235,0.35);border-radius:4px;color:#cfe0f5;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15px;padding:4px 6px;" />
  </div>

</div>
