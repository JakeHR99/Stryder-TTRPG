{{!-- ======================================================
     GEAR INVENTORY GRID
     ====================================================== --}}
<div class="jrpg-inventory-wrap" style="display:flex;flex-direction:column;gap:8px;padding:12px;width:100%;box-sizing:border-box;">

  <div class="jrpg-inv-header">
    <span class="jrpg-inv-title">INVENTORY</span>
    <span class="jrpg-inv-capacity {{#if inventoryFull}}inv-full{{/if}}">
      {{inventoryUsed}} / {{inventoryMax}} slots
    </span>
  </div>

  <div class="jrpg-inv-grid" data-drop-zone="inventory" style="display:grid !important;grid-template-columns:repeat(11,1fr);gap:3px;width:100%;box-sizing:border-box;">
    {{#each inventoryGrid}}
      {{#if this.empty}}
        <div class="inv-slot inv-empty" data-slot-id="{{this.id}}" data-slot-index="{{this.slotIndex}}" data-action="addItemFromSlot" style="cursor:pointer;aspect-ratio:1/1;min-width:0;overflow:hidden;background:rgba(8,14,35,0.6);border:1px solid rgba(60,90,160,0.18);border-radius:5px;display:flex;align-items:center;justify-content:center;transition:background 0.18s ease,border-color 0.18s ease,box-shadow 0.18s ease;"></div>
      {{else}}
        <div class="inv-slot inv-item
          {{#if this.isSolo}}inv-solo{{/if}}
          {{#if this.isStart}}inv-start{{/if}}
          {{#if this.isMid}}inv-mid{{/if}}
          {{#if this.isEnd}}inv-end{{/if}}"
          data-item-id="{{this.itemId}}"
          data-slot-id="{{this.id}}"
          data-slot-index="{{this.slotIndex}}"
          {{#if this.clickable}}data-clickable="true"{{/if}}
          title="{{this.itemName}} ({{this.itemSize}} slot{{#if (gt this.itemSize 1)}}s{{/if}})"
          style="aspect-ratio:1/1;min-width:0;overflow:hidden;display:flex;align-items:center;justify-content:center;transition:box-shadow 0.18s ease,filter 0.18s ease;">
          {{#if this.showIcon}}
            {{#if this.itemImg}}
              <img class="inv-item-img" src="{{this.itemImg}}" alt="{{this.itemName}}" style="width:65%;height:65%;object-fit:contain;max-width:100%;max-height:100%;">
            {{else}}
              <i class="fas fa-box inv-item-icon"></i>
            {{/if}}
          {{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>

</div>
