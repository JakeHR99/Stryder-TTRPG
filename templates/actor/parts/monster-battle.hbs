<h2 class="section-header"><span class="header-decoration left"></span><img src="systems/stryder/assets/senses.svg" width="25px" height="25px"><strong>{{localize "Senses"}}</strong><span class="header-decoration right"></span></h2>
<div class="skills-container">
    <div class="skills-grid senses">
        {{#each system.attributes.sense as |sense key|}}
            <div class="skill">
                <img src="systems/stryder/assets/{{key}}-icon.svg" alt="{{key}} icon" class="skill-icon">
                <span class="skill-label rollable" data-roll="2d6+@attributes.sense.{{key}}.value" data-label="{{key}}">
                    {{key}}
                </span>
                <input type="text" name="system.attributes.sense.{{key}}.value" value="{{sense.value}}" data-dtype="Number">
            </div>
        {{/each}}
    </div>
	<br />
    </div>
<h2 class="section-header"><span class="header-decoration left"></span><img src="systems/stryder/assets/talents.svg" width="25px" height="25px"><strong>{{localize "Talents"}}</strong><span class="header-decoration right"></span></h2>
<div class="skills-container">
    <div class="skills-grid talents">
        {{#each system.attributes.talent as |talent key|}}
            <div class="skill">
                <img src="systems/stryder/assets/{{key}}-icon.svg" alt="{{key}} icon" class="skill-icon">
                <span class="skill-label rollable" data-roll="2d6+@attributes.talent.{{key}}.value" data-label="{{key}}">
                    {{key}}
                </span>
                <input type="text" name="system.attributes.talent.{{key}}.value" value="{{talent.value}}" data-dtype="Number">
            </div>
        {{/each}}
    </div>
</div>
