{{!-- Monster Field Guide Sheet --}}
<form class="{{cssClass}} {{actor.type}} monster-sheet" autocomplete="off">
  {{!-- ── HEADER ─────────────────────────────────────────────── --}}
  <div class="ms-header">
    <div class="ms-header-left">
      <input class="ms-name-input" name="name" type="text" value="{{actor.name}}" placeholder="Monster Name"/>
      <div class="ms-subtype">
        <input class="ms-subtype-input" name="system.attributes.habitat" type="text"
          value="{{system.attributes.habitat}}" placeholder="Type · Habitat"/>
      </div>
    </div>
    <div class="ms-rank-badge">
      <div class="ms-rank-label">RANK</div>
      <input class="ms-rank-input" name="system.attributes.rank.value" type="text"
        value="{{system.attributes.rank.value}}" data-dtype="Number" placeholder="—"/>
    </div>
  </div>
  {{!-- ── BODY (left stats + right abilities) ───────────────── --}}
  <div class="ms-body">
    {{!-- LEFT PANEL --}}
    <div class="ms-left">
      {{!-- Art --}}
      <div class="ms-art-frame">
        <img class="ms-art-img profile-img" src="{{actor.img}}"
          data-edit="img" title="{{actor.name}}" alt="{{actor.name}}"/>
      </div>
      {{!-- Wounds --}}
      <div class="ms-stat-block">
        <div class="ms-stat-label">WOUNDS</div>
        <div class="ms-wounds-pips" data-wounds-value="{{system.wounds.value}}" data-wounds-max="{{system.wounds.max}}">
          {{!-- Filled by activateListeners JS --}}
        </div>
        <div class="ms-wounds-inputs">
          <input type="number" name="system.wounds.value" value="{{system.wounds.value}}"
            min="0" class="ms-wounds-val" data-dtype="Number"/>
          <span class="ms-wounds-sep">/</span>
          <input type="number" name="system.wounds.max" value="{{system.wounds.max}}"
            min="0" class="ms-wounds-max" data-dtype="Number"/>
        </div>
      </div>
      {{!-- Guard --}}
      <div class="ms-stat-block ms-guard-block">
        <div class="ms-stat-label">GUARD</div>
        <input type="number" name="system.guard" value="{{system.guard}}"
          class="ms-guard-input" data-dtype="Number" placeholder="0"/>
        <div class="ms-guard-thresholds" data-guard="{{system.guard}}">
          {{!-- Filled by activateListeners JS --}}
        </div>
      </div>
      {{!-- Movement --}}
      <div class="ms-stat-block">
        <div class="ms-stat-label">MOVEMENT</div>
        <table class="ms-move-table">
          <tr>
            <td class="ms-move-name">Running</td>
            <td><input type="number" name="system.attributes.move.running.value"
              value="{{system.attributes.move.running.value}}" data-dtype="Number" class="ms-move-input"/>m</td>
          </tr>
          <tr>
            <td class="ms-move-name">Climbing</td>
            <td><input type="number" name="system.attributes.move.climbing.value"
              value="{{system.attributes.move.climbing.value}}" data-dtype="Number" class="ms-move-input"/>m</td>
          </tr>
          <tr>
            <td class="ms-move-name">Swimming</td>
            <td><input type="number" name="system.attributes.move.swimming.value"
              value="{{system.attributes.move.swimming.value}}" data-dtype="Number" class="ms-move-input"/>m</td>
          </tr>
        </table>
      </div>
    </div>
    {{!-- RIGHT PANEL — abilities --}}
    <div class="ms-right">
      <div class="ms-ability-section">
        <div class="ms-ability-header">
          <span>Abilities</span>
          <a class="item-control item-create" data-type="generic" title="Add Ability">
            <i class="fas fa-plus"></i>
          </a>
        </div>
        <ol class="ms-ability-list">
          {{#each generic as |item|}}
          <li class="ms-ability-item item" data-item-id="{{item._id}}">
            <a class="rollable" data-roll-type="item">
              <img src="{{item.img}}" title="{{item.name}}" width="18" height="18"/>
            </a>
            <span class="ms-ability-name">{{item.name}}</span>
            <span class="ms-atk-toggle {{#if item.system.isAttack}}is-attack{{/if}}"
              data-item-id="{{item._id}}" title="{{#if item.system.isAttack}}Attack — click to make Utility{{else}}Utility — click to make Attack{{/if}}">
              {{#if item.system.isAttack}}<i class="fas fa-fist-raised"></i>{{else}}<i class="fas fa-scroll"></i>{{/if}}
            </span>
            <span class="ms-ability-controls item-controls">
              <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
          {{#each passive as |item|}}
          <li class="ms-ability-item item" data-item-id="{{item._id}}">
            <a class="rollable" data-roll-type="item">
              <img src="{{item.img}}" title="{{item.name}}" width="18" height="18"/>
            </a>
            <span class="ms-ability-name">{{item.name}}</span>
            <span class="ms-ability-controls item-controls">
              <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
          {{#each actions as |item|}}
          <li class="ms-ability-item item" data-item-id="{{item._id}}">
            <a class="rollable" data-roll-type="item">
              <img src="{{item.img}}" title="{{item.name}}" width="18" height="18"/>
            </a>
            <span class="ms-ability-name">{{item.name}}</span>
            <span class="ms-ability-controls item-controls">
              <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>
  </div>
  {{!-- ── TAB STRIP ───────────────────────────────────────────── --}}
  <div class="ms-tabs">
    <button type="button" class="ms-tab active" data-page="biography">Biography</button>
    <button type="button" class="ms-tab" data-page="loot">Loot</button>
    <div class="ms-tabs-fill"></div>
  </div>
  {{!-- ── TAB PAGES ───────────────────────────────────────────── --}}
  <div class="ms-tab-pages">
    {{!-- Biography --}}
    <div class="ms-page" data-page="biography">
      <div class="ms-bio-content">
        {{editor system.biography target="system.biography" button=true engine="prosemirror" collaborate=false}}
      </div>
    </div>
    {{!-- Loot --}}
    <div class="ms-page" data-page="loot" style="display:none;">
      <div class="ms-loot-header">
        <span class="ms-loot-title">Drop Table</span>
        <a class="item-control item-create ms-loot-add" data-type="loot" title="Add Loot Item">
          <i class="fas fa-plus"></i> Add
        </a>
      </div>
      {{#if loot}}
      <ol class="ms-loot-list">
        {{#each loot as |item|}}
        <li class="ms-loot-item item" data-item-id="{{item._id}}">
          <img src="{{item.img}}" width="18" height="18"/>
          <span class="ms-loot-name">{{item.name}}</span>
          <span class="ms-loot-controls item-controls">
            <a class="item-control item-edit" title="Edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Delete"><i class="fas fa-trash"></i></a>
          </span>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="ms-loot-empty">No loot assigned yet.</p>
      {{/if}}
    </div>
  </div>
</form>
