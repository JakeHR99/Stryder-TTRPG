<form class="{{cssClass}} {{actor.type}} monster-sheet" autocomplete="off"
  style="background:#f0e8cc; overflow:hidden; padding:0; display:flex; flex-direction:column; height:100%;">

  <div style="display:flex; flex-direction:row; flex:1; min-height:0; padding:12px; box-sizing:border-box; gap:12px; overflow:hidden;">

    <!-- LEFT PANEL -->
    <div style="flex:0 0 43%; display:flex; flex-direction:column; gap:8px; overflow-y:auto; padding-right:4px;">

      <!-- Name + Threat Level -->
      <div style="display:flex; flex-direction:row; align-items:flex-end; gap:10px;">
        <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
          <label style="font-size:12px; font-weight:700; color:#222; text-transform:uppercase; letter-spacing:.05em;">Name</label>
          <input name="name" type="text" value="{{actor.name}}" placeholder="Monster Name"
            style="background:transparent; border:none; border-bottom:2px solid #333; border-radius:0; font-size:16px; color:#111; padding:2px 0; box-shadow:none; width:100%;"/>
        </div>
        <div style="flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:2px;">
          <label style="font-size:12px; font-weight:700; color:#222; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap;">Threat Level</label>
          <input type="text" name="system.attributes.rank.value" value="{{system.attributes.rank.value}}" data-dtype="Number"
            style="width:54px; font-size:20px; font-weight:700; text-align:center; background:transparent; border:2.5px solid #222; padding:3px; color:#111; box-shadow:none;"/>
        </div>
      </div>

      <!-- Row 1: Health / Might / Move. / Range -->
      <div style="display:flex; flex-direction:row; gap:6px;">

        <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:4px;">
            <div style="display:flex; flex-direction:row; align-items:center; justify-content:center; gap:1px; width:100%;">
              <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"
                style="width:38%; font-size:13px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
              <span style="font-size:12px; font-weight:700; color:#444;">/</span>
              <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"
                style="width:38%; font-size:13px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
            </div>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Health</label>
        </div>

        <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">
            <input type="text" name="system.abilities.Might.value" value="{{system.abilities.Might.value}}" data-dtype="Number"
              style="width:80%; font-size:22px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Might</label>
        </div>

        <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">
            <input type="text" name="system.attributes.move.running.value" value="{{system.attributes.move.running.value}}" data-dtype="Number"
              style="width:80%; font-size:22px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Move.</label>
        </div>

        <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">
            <input type="text" name="system.attributes.range.value" value="{{system.attributes.range.value}}" data-dtype="Number"
              style="width:80%; font-size:22px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Range</label>
        </div>

      </div>

      <!-- Row 2: Stamina / Potency / Resistance -->
      <div style="display:flex; flex-direction:row; gap:6px;">

        <div style="flex:0 0 calc(33% - 4px); display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:4px;">
            <div style="display:flex; flex-direction:row; align-items:center; justify-content:center; gap:1px; width:100%;">
              <input type="text" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number"
                style="width:38%; font-size:13px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
              <span style="font-size:12px; font-weight:700; color:#444;">/</span>
              <input type="text" name="system.stamina.max" value="{{system.stamina.max}}" data-dtype="Number"
                style="width:38%; font-size:13px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
            </div>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Stamina</label>
        </div>

        <div style="flex:0 0 calc(33% - 4px); display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">
            <input type="text" name="system.attributes.physical_potency.value" value="{{system.attributes.physical_potency.value}}" data-dtype="Number"
              style="width:80%; font-size:22px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Potency</label>
        </div>

        <div style="flex:0 0 calc(33% - 4px); display:flex; flex-direction:column; align-items:center; gap:3px;">
          <div style="width:100%; aspect-ratio:1/1; border:3px solid #111; display:flex; align-items:center; justify-content:center; box-sizing:border-box;">
            <input type="text" name="system.attributes.physical_resistance.base" value="{{system.attributes.physical_resistance.base}}" data-dtype="Number"
              style="width:80%; font-size:22px; font-weight:700; text-align:center; background:transparent; border:none; color:#111; padding:0; box-shadow:none;"/>
          </div>
          <label style="font-size:11px; font-weight:700; color:#222; text-align:center;">Resistance</label>
        </div>

      </div>

      <!-- Corruption Traits -->
      <div style="display:flex; flex-direction:column; gap:3px; margin-top:2px;">
        <label style="font-size:12px; font-weight:700; color:#222;">Corruption Trait(s)</label>
        <select name="system.attributes.corruption_traits"
          style="font-size:13px; background:rgba(255,255,255,0.3); border:1px solid #666; padding:3px 6px; color:#111; width:100%;">
          {{#select system.attributes.corruption_traits}}
          <option value="none">— None —</option>
          <option value="corrupted">Corrupted</option>
          <option value="undead">Undead</option>
          <option value="spectral">Spectral</option>
          <option value="feral">Feral</option>
          <option value="possessed">Possessed</option>
          <option value="shadow_touched">Shadow Touched</option>
          <option value="arcane_tainted">Arcane Tainted</option>
          <option value="void_born">Void Born</option>
          <option value="cursed">Cursed</option>
          {{/select}}
        </select>
      </div>

      <!-- Senses / Talents / Body -->
      <div style="display:flex; flex-direction:row; gap:10px; margin-top:4px; flex:1;">

        <!-- Senses -->
        <div style="flex:1; display:flex; flex-direction:column; gap:3px;">
          <label style="font-size:13px; font-weight:700; color:#111; border-bottom:1px solid #999; padding-bottom:2px; margin-bottom:3px;">Senses</label>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:52px;">Arcane:</span>
            <input type="text" name="system.attributes.sense.arcane.value" value="{{system.attributes.sense.arcane.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:52px;">Sight:</span>
            <input type="text" name="system.attributes.sense.sight.value" value="{{system.attributes.sense.sight.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:52px;">Smell:</span>
            <input type="text" name="system.attributes.sense.smell.value" value="{{system.attributes.sense.smell.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:52px;">Hearing:</span>
            <input type="text" name="system.attributes.sense.hearing.value" value="{{system.attributes.sense.hearing.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:52px;">Touch:</span>
            <input type="text" name="system.attributes.sense.touch.value" value="{{system.attributes.sense.touch.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
        </div>

        <!-- Talents -->
        <div style="flex:1; display:flex; flex-direction:column; gap:3px;">
          <label style="font-size:13px; font-weight:700; color:#111; border-bottom:1px solid #999; padding-bottom:2px; margin-bottom:3px;">Talents</label>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:62px;">Strength:</span>
            <input type="text" name="system.attributes.talent.strength.value" value="{{system.attributes.talent.strength.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:62px;">Nimbleness:</span>
            <input type="text" name="system.attributes.talent.nimbleness.value" value="{{system.attributes.talent.nimbleness.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:62px;">Survival:</span>
            <input type="text" name="system.attributes.talent.survival.value" value="{{system.attributes.talent.survival.value}}" data-dtype="Number"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
        </div>

        <!-- Body -->
        <div style="flex:1; display:flex; flex-direction:column; gap:3px;">
          <label style="font-size:13px; font-weight:700; color:#111; border-bottom:1px solid #999; padding-bottom:2px; margin-bottom:3px;">Body</label>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:36px;">Size</span>
            <select name="system.attributes.creature_size"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; min-width:0;">
              {{#select system.attributes.creature_size}}
              <option value="0.25">Mini</option>
              <option value="0.5">Small</option>
              <option value="1">Normal</option>
              <option value="2">Huge</option>
              <option value="3">Massive</option>
              <option value="4">Colossal</option>
              <option value="5">Titanic</option>
              {{/select}}
            </select>
          </div>
          <div style="display:flex; flex-direction:row; align-items:baseline; gap:3px;">
            <span style="font-size:11px; color:#333; min-width:36px;">Weight:</span>
            <input type="text" name="system.attributes.weight" value="{{system.attributes.weight}}" placeholder="—"
              style="flex:1; font-size:11px; background:transparent; border:none; border-bottom:1px solid #bbb; color:#111; padding:0 2px; box-shadow:none; min-width:0;"/>
          </div>
        </div>

      </div>

    </div>

    <!-- RIGHT PANEL -->
    <div style="flex:1; display:flex; flex-direction:column; border:2px solid #333; overflow:hidden; min-width:0;">

      <!-- Top: Offensive + Defensive side by side -->
      <div style="display:flex; flex-direction:row; flex:1 1 60%; min-height:0; border-bottom:2px solid #333; overflow:hidden;">

        <!-- Offensive -->
        <div style="flex:1; display:flex; flex-direction:column; border-right:2px solid #333; min-height:0; overflow:hidden;">
          <div style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding:4px 8px; border-bottom:2px solid #333; background:rgba(0,0,0,0.04); flex-shrink:0;">
            <span style="font-size:12px; font-weight:700; color:#111;">Offensive abilities</span>
            <a class="item-control item-create" data-type="generic" title="Add"
              style="font-size:10px; color:#444; cursor:pointer; padding:1px 5px; border:1px solid #888; border-radius:3px; background:rgba(255,255,255,0.4); text-decoration:none; line-height:1.4;">
              <i class="fas fa-plus"></i>
            </a>
          </div>
          <ol style="list-style:none; margin:0; padding:2px 0; overflow-y:auto; flex:1;">
            {{#each generic as |item|}}
            <li class="monster-ability-item item" data-item-id="{{item._id}}"
              style="display:flex; flex-direction:row; align-items:center; gap:5px; padding:3px 7px; border-bottom:1px solid rgba(0,0,0,0.08);">
              <a class="rollable" data-roll-type="item" style="flex-shrink:0;">
                <img src="{{item.img}}" title="{{item.name}}" width="18" height="18" style="border:none; display:block;"/>
              </a>
              <span style="flex:1; font-size:12px; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{item.name}}</span>
              <span class="item-controls" style="display:none; flex-direction:row; gap:3px;">
                <a class="item-control item-edit" title="Edit" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-trash"></i></a>
              </span>
            </li>
            {{/each}}
          </ol>
        </div>

        <!-- Defensive -->
        <div style="flex:1; display:flex; flex-direction:column; min-height:0; overflow:hidden;">
          <div style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding:4px 8px; border-bottom:2px solid #333; background:rgba(0,0,0,0.04); flex-shrink:0;">
            <span style="font-size:12px; font-weight:700; color:#111;">Defensive Abilities</span>
            <a class="item-control item-create" data-type="passive" title="Add"
              style="font-size:10px; color:#444; cursor:pointer; padding:1px 5px; border:1px solid #888; border-radius:3px; background:rgba(255,255,255,0.4); text-decoration:none; line-height:1.4;">
              <i class="fas fa-plus"></i>
            </a>
          </div>
          <ol style="list-style:none; margin:0; padding:2px 0; overflow-y:auto; flex:1;">
            {{#each passive as |item|}}
            <li class="monster-ability-item item" data-item-id="{{item._id}}"
              style="display:flex; flex-direction:row; align-items:center; gap:5px; padding:3px 7px; border-bottom:1px solid rgba(0,0,0,0.08);">
              <a class="rollable" data-roll-type="item" style="flex-shrink:0;">
                <img src="{{item.img}}" title="{{item.name}}" width="18" height="18" style="border:none; display:block;"/>
              </a>
              <span style="flex:1; font-size:12px; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{item.name}}</span>
              <span class="item-controls" style="display:none; flex-direction:row; gap:3px;">
                <a class="item-control item-edit" title="Edit" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-trash"></i></a>
              </span>
            </li>
            {{/each}}
          </ol>
        </div>

      </div>

      <!-- Utility -->
      <div style="flex:0 0 38%; display:flex; flex-direction:column; min-height:0; overflow:hidden;">
        <div style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding:4px 8px; border-bottom:2px solid #333; background:rgba(0,0,0,0.04); flex-shrink:0;">
          <span style="font-size:12px; font-weight:700; color:#111;">Utility abilities</span>
          <a class="item-control item-create" data-type="action" title="Add"
            style="font-size:10px; color:#444; cursor:pointer; padding:1px 5px; border:1px solid #888; border-radius:3px; background:rgba(255,255,255,0.4); text-decoration:none; line-height:1.4;">
            <i class="fas fa-plus"></i>
          </a>
        </div>
        <ol style="list-style:none; margin:0; padding:2px 0; overflow-y:auto; flex:1;">
          {{#each actions as |item|}}
          <li class="monster-ability-item item" data-item-id="{{item._id}}"
            style="display:flex; flex-direction:row; align-items:center; gap:5px; padding:3px 7px; border-bottom:1px solid rgba(0,0,0,0.08);">
            <a class="rollable" data-roll-type="item" style="flex-shrink:0;">
              <img src="{{item.img}}" title="{{item.name}}" width="18" height="18" style="border:none; display:block;"/>
            </a>
            <span style="flex:1; font-size:12px; color:#111; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{item.name}}</span>
            <span class="item-controls" style="display:none; flex-direction:row; gap:3px;">
              <a class="item-control item-edit" title="Edit" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Delete" style="font-size:10px; color:#555; cursor:pointer; text-decoration:none;"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
        </ol>
      </div>

    </div>

  </div>

  <style>.monster-ability-item:hover .item-controls { display:flex !important; }</style>

</form>

{{log system}}
