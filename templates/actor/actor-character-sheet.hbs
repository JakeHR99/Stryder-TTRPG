							<span class="folk-size-weight">Size: {{folkDisplay.size}} · Weight: {{folkDisplay.weight}}</span>
							{{#each folkDisplay.passives}}
							<div class="folk-passive">⚑ {{this}}</div>
							{{/each}}
						</div>
						{{/if}}
					</div>

					<!-- Resources + Stats side by side -->
					<div class="jrpg-char-res-stats-row">

						<!-- ── Resources (left, compact) ── -->
						<div class="jrpg-char-col-resources">
							<h3 class="jrpg-char-section-title">Resources</h3>

							<div class="jrpg-res-compact-row">
								<span class="jrpg-char-res-label hp-label">HP</span>
								<div class="jrpg-res-compact-inputs">
									<input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" class="jrpg-char-input jrpg-res-compact-input" />
									<span class="jrpg-char-divider">/</span>
									<span class="jrpg-res-max-display hp-label" title="Base max HP (class + grit)">{{system.health.max}}</span>
									<span class="jrpg-res-bonus-sep">+</span>
									<input type="number" name="system.health.bonus" value="{{system.health.bonus}}" data-dtype="Number"
										class="jrpg-char-input jrpg-res-bonus-input" placeholder="0" title="Bonus max HP" min="0" />
									<button type="button" class="jrpg-reset-btn resource-button" data-action="resetHpMax" title="Remove bonus HP">↺</button>
								</div>
								<div class="jrpg-char-bar-track"><div class="jrpg-char-bar hp-fill" style="width:{{system.health.value}}%"></div></div>
							</div>
							<div class="jrpg-char-hp-breakdown">
							  <span class="jrpg-char-hp-src">Class + Level</span>
							  <span class="jrpg-char-hp-plus">+</span>
							  <span class="jrpg-char-hp-src">Grit ×{{gritMilestonesReached}} milestone{{#if (gt gritMilestonesReached 1)}}s{{/if}} (+{{gritHpBonus}})</span>
							</div>

							<div class="jrpg-res-compact-row">
								<span class="jrpg-char-res-label mp-label">MP</span>
								<div class="jrpg-res-compact-inputs">
									<input type="number" name="system.mana.value" value="{{system.mana.value}}" data-dtype="Number" class="jrpg-char-input jrpg-res-compact-input" />
									<span class="jrpg-char-divider">/</span>
									<input type="number" name="system.mana.max" value="{{system.mana.max}}" data-dtype="Number" class="jrpg-char-input jrpg-res-compact-input" />
								</div>
								<div class="jrpg-char-bar-track"><div class="jrpg-char-bar mp-fill" style="width:{{system.mana.value}}%"></div></div>
							</div>

							<div class="jrpg-res-compact-row">
								<span class="jrpg-char-res-label sp-label">STA</span>
								<div class="jrpg-res-compact-inputs">
									<input type="number" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number" class="jrpg-char-input jrpg-res-compact-input" />
									<span class="jrpg-char-divider">/</span>
									<input type="number" name="system.stamina.max" value="{{system.stamina.max}}" data-dtype="Number" class="jrpg-char-input jrpg-res-compact-input" />
								</div>
								<div class="jrpg-char-bar-track"><div class="jrpg-char-bar sp-fill" style="width:{{system.stamina.value}}%"></div></div>
							</div>
						</div>

						<!-- ── Stats (right, stepper) ── -->
