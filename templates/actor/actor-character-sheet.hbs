									<input type="number" name="system.abilities.Soul.value" value="{{system.abilities.Soul.value}}" data-dtype="Number" class="jrpg-char-input jrpg-stat-input" />
									<button type="button" class="stat-btn stat-btn-up" data-stat="Soul">+</button>
								</div>
							</div>

							<div class="jrpg-stat-row">
								<label class="jrpg-char-label rollable" data-roll="2d6+@abilities.Reflex.value" data-label="Reflex Check">Reflex</label>
								<div class="jrpg-stat-stepper">
									<button type="button" class="stat-btn stat-btn-down" data-stat="Reflex">−</button>
									<input type="number" name="system.abilities.Reflex.value" value="{{system.abilities.Reflex.value}}" data-dtype="Number" class="jrpg-char-input jrpg-stat-input" />
									<button type="button" class="stat-btn stat-btn-up" data-stat="Reflex">+</button>
								</div>
							</div>

							<div class="jrpg-stat-row">
								<label class="jrpg-char-label rollable" data-roll="2d6+@abilities.Grit.value" data-label="Grit Check">Grit</label>
								<div class="jrpg-stat-stepper">
									<button type="button" class="stat-btn stat-btn-down" data-stat="Grit">−</button>
									<input type="number" name="system.abilities.Grit.value" value="{{system.abilities.Grit.value}}" data-dtype="Number" class="jrpg-char-input jrpg-stat-input" />
									<button type="button" class="stat-btn stat-btn-up" data-stat="Grit">+</button>
								</div>
							</div>

							<div class="jrpg-stat-row">
								<label class="jrpg-char-label rollable" data-roll="2d6+@abilities.Will.value" data-label="Will Check">Will</label>
								<div class="jrpg-stat-stepper">
									<button type="button" class="stat-btn stat-btn-down" data-stat="Will">−</button>
									<input type="number" name="system.abilities.Will.value" value="{{system.abilities.Will.value}}" data-dtype="Number" class="jrpg-char-input jrpg-stat-input" />
