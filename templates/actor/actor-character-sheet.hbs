        <!-- Identity row: image left, name/desc/summary right -->
        <div class="sa-identity">
          <div class="sa-img-wrap">
            <img class="sa-portrait" src="{{system.soul_armament.img}}" data-edit="system.soul_armament.img" title="Click to change image" />
            <span class="sa-img-hint">Click to change</span>
          </div>
          <div class="sa-identity-info">
            <input class="sa-name-input" type="text" name="system.soul_armament.name" value="{{system.soul_armament.name}}" placeholder="Soul Armament Name…" />
            <textarea class="sa-desc-input" name="system.soul_armament.description" placeholder="Describe your Soul Armament…">{{system.soul_armament.description}}</textarea>
            <div class="sa-summary">
              <div class="sa-sum-row"><span class="sa-sum-label">Form</span><span class="sa-sum-val">{{saSumForm}}</span></div>
              <div class="sa-sum-row"><span class="sa-sum-label">Range</span><span class="sa-sum-val">{{saSumRange}}</span></div>
              <div class="sa-sum-row"><span class="sa-sum-label">Temper</span><span class="sa-sum-val">{{saSumTemper}}</span></div>
              <div class="sa-sum-row"><span class="sa-sum-label">Capacity</span><span class="sa-sum-val">{{saSumCapacity}}</span></div>
            </div>
            <button type="button" class="sa-display-btn" data-action="displaySoulArmament" title="Post your Soul Armament's image, description, and features to chat"><i class="fas fa-share-square"></i> Display</button>
          </div>
        </div>

        <!-- DP tracker -->
        <div class="sa-dp-section">
          <span class="sa-dp-label">Design Points</span>
          <div class="sa-dp-track">
            <div class="sa-dp-fill {{#if saDPOver}}sa-dp-over{{/if}}" style="width: {{saDPPct}}%"></div>
          </div>
          <span class="sa-dp-nums {{#if saDPOver}}sa-dp-over{{/if}}">{{saDPSpent}} / {{saDPMax}}</span>
        </div>

        <!-- Options grid: 2 columns × 2 rows -->
        <div class="sa-options-grid">

          <!-- FORM (multi-select) -->
          <div class="sa-section">
            <h4 class="sa-section-title">Form <span class="sa-section-note">choose any</span></h4>
            <div class="sa-option {{#if system.soul_armament.form.one_handed}}sa-selected{{/if}}" data-field="form" data-value="one_handed"
                 data-sa-tip="No benefit. A simple, versatile grip.">
              <span class="sa-opt-name">1 Handed</span><span class="sa-opt-cost sa-free">Free</span>
            </div>
            <div class="sa-option {{#if system.soul_armament.form.two_handed}}sa-selected{{/if}}" data-field="form" data-value="two_handed"
                 data-sa-tip="Your base damage increases by 1.">
              <span class="sa-opt-name">Two Handed</span><span class="sa-opt-cost">1 DP</span>
            </div>
            <div class="sa-option {{#if system.soul_armament.form.ingrained}}sa-selected{{/if}}" data-field="form" data-value="ingrained"
                 data-sa-tip="You can't be disarmed. You learn the Core Abilities of the Aspect of Discipline and can use them while in any other form. Discipline abilities used in a different Aspect use that Aspect's damage stat.">
              <span class="sa-opt-name">Ingrained</span><span class="sa-opt-cost">2 DP</span>
            </div>
            <div class="sa-option {{#if system.soul_armament.form.attached}}sa-selected{{/if}}" data-field="form" data-value="attached"
                 data-sa-tip="You can't be disarmed. Select one Aspect — you permanently gain that Aspect's Attached Bonus. You may change the chosen Aspect when you visit a Spring of Life.">
              <span class="sa-opt-name">Attached</span><span class="sa-opt-cost">2 DP</span>
            </div>
            <div class="sa-option {{#if system.soul_armament.form.dual_wield}}sa-selected{{/if}}" data-field="form" data-value="dual_wield"
                 data-sa-tip="Gain access to the Block player action (scales off your attuned Aspect's damage stat). Also gain Twin Attack: on a Focused Attack, deal half damage and instantly make a second attack that also deals half damage at no cost.">
              <span class="sa-opt-name">Dual Wield</span><span class="sa-opt-cost">2 DP</span>
            </div>
          </div>

          <!-- RANGE (single-select) -->
          <div class="sa-section">
            <h4 class="sa-section-title">Reach & Range <span class="sa-section-note">choose one</span></h4>
            <div class="sa-option sa-radio {{#if saRangeIs.range1}}sa-selected{{/if}}" data-field="range" data-value="range1"
                 data-sa-tip="Melee range only. Good for daggers, swords, and maces.">
              <span class="sa-opt-name">Range of 1</span><span class="sa-opt-cost sa-free">Free</span>
            </div>
            <div class="sa-option sa-radio {{#if saRangeIs.range2}}sa-selected{{/if}}" data-field="range" data-value="range2"
                 data-sa-tip="Extended melee reach. Good for spears, whips, and lances.">
              <span class="sa-opt-name">Range of 2</span><span class="sa-opt-cost">1 DP</span>
            </div>
            <div class="sa-option sa-radio {{#if saRangeIs.range5}}sa-selected{{/if}}" data-field="range" data-value="range5"
                 data-sa-tip="Mid-range. Good for short bows and guns.">
              <span class="sa-opt-name">Range of 5</span><span class="sa-opt-cost">2 DP</span>
            </div>
            <div class="sa-option sa-radio {{#if saRangeIs.range8}}sa-selected{{/if}}" data-field="range" data-value="range8"
                 data-sa-tip="Long range. Good for snipers, long bows, and crossbows.">
              <span class="sa-opt-name">Range of 8</span><span class="sa-opt-cost">3 DP</span>
            </div>
          </div>

          <!-- TEMPER (single-select) -->
          <div class="sa-section">
            <h4 class="sa-section-title">Temper <span class="sa-section-note">choose one</span></h4>
            <div class="sa-option sa-radio {{#if saTemperIs.basic}}sa-selected{{/if}}" data-field="temper" data-value="basic"
                 data-sa-tip="No special effect.">
              <span class="sa-opt-name">Basic</span><span class="sa-opt-cost sa-free">Free</span>
            </div>
            <div class="sa-option sa-radio {{#if saTemperIs.keen}}sa-selected{{/if}}" data-field="temper" data-value="keen"
                 data-sa-tip="+1 to all Attack Rolls.">
              <span class="sa-opt-name">Keen</span><span class="sa-opt-cost">2 DP</span>
            </div>
            <div class="sa-option sa-radio {{#if saTemperIs.heavy}}sa-selected{{/if}}" data-field="temper" data-value="heavy"
                 data-sa-tip="Choose a Weight Class for your weapon. Deal +1 bonus damage on Focused Attacks at Weight Class 3, +1 more for each Weight Class above that. Penalty: Attack Rolls suffer -1 for each Weight Class your weapon exceeds your Strength stat.">
              <span class="sa-opt-name">Heavy</span><span class="sa-opt-cost">2 DP</span>
            </div>
            {{#if saTemperIs.heavy}}
            <div class="sa-heavy-wc-row">
              <label class="sa-heavy-wc-label">Weapon Weight Class</label>
              <select name="system.soul_armament.weaponWeightClass" class="sa-heavy-wc-select">
                {{#sty-select system.soul_armament.weaponWeightClass}}
                <option value="3">WC 3 (+1 dmg)</option>
                <option value="4">WC 4 (+2 dmg)</option>
                <option value="5">WC 5 (+3 dmg)</option>
                <option value="6">WC 6 (+4 dmg)</option>
                <option value="7">WC 7 (+5 dmg)</option>
                <option value="8">WC 8 (+6 dmg)</option>
                <option value="9">WC 9 (+7 dmg)</option>
                <option value="10">WC 10 (+8 dmg)</option>
                {{/sty-select}}
              </select>
            </div>
            {{/if}}
          </div>

          <!-- SOUL STONE CAPACITY (single-select) -->
          <div class="sa-section">
            <h4 class="sa-section-title">Soul Stone Capacity <span class="sa-section-note">choose one</span></h4>
            <div class="sa-option sa-radio {{#if saCapIs.slot1}}sa-selected{{/if}}" data-field="capacity" data-value="slot1"
                 data-sa-tip="Your Soul Armament can hold 1 Soul Stone. Soul Stones upgrade your weapon and grant new powerful effects.">
              <span class="sa-opt-name">1 Slot</span><span class="sa-opt-cost sa-free">Free</span>
            </div>
            <div class="sa-option sa-radio {{#if saCapIs.slot2}}sa-selected{{/if}}" data-field="capacity" data-value="slot2"
                 data-sa-tip="Your Soul Armament can hold 2 Soul Stones.">
              <span class="sa-opt-name">2 Slots</span><span class="sa-opt-cost">1 DP</span>
            </div>
            <div class="sa-option sa-radio {{#if saCapIs.slot3}}sa-selected{{/if}}" data-field="capacity" data-value="slot3"
                 data-sa-tip="Your Soul Armament can hold 3 Soul Stones.">
              <span class="sa-opt-name">3 Slots</span><span class="sa-opt-cost">2 DP</span>
            </div>
            <div class="sa-option sa-radio {{#if saCapIs.slot4}}sa-selected{{/if}}" data-field="capacity" data-value="slot4"
                 data-sa-tip="Your Soul Armament can hold 4 Soul Stones.">
              <span class="sa-opt-name">4 Slots</span><span class="sa-opt-cost">4 DP</span>
            </div>
          </div>

        </div><!-- .sa-options-grid -->
      </div><!-- .sa-screen -->
			</div>
			<div class="jrpg-page" data-page="growth">
  <div class="jrpg-growth-wrap">
    <div class="jrpg-growth-exp-bar">
      <div class="jrpg-growth-exp-gem"></div>
      <div>
        <span class="jrpg-growth-exp-label">Experience Points</span>
        <span class="jrpg-growth-exp-num">{{system.attributes.xp.value}}</span>
        <span class="jrpg-growth-exp-sub">available to spend</span>
      </div>
      <div class="jrpg-growth-class-info">{{system.class.name}} &middot; Level {{system.attributes.level.value}}</div>
    </div>
    <div class="jrpg-growth-body">
      <div class="jrpg-growth-panel" id="jrpg-growth-class-panel">
        <div class="jrpg-growth-loading">Loading class path&#8230;</div>
      </div>
      <div class="jrpg-growth-panel" id="jrpg-growth-buy-panel">
        <div class="jrpg-growth-loading">Loading abilities&#8230;</div>
      </div>
    </div>
  </div>
			</div>
			<div class="jrpg-page" data-page="effects">
				{{> "systems/stryder/templates/actor/parts/actor-effects.hbs"}}
			</div>
		</div>
	</div>

</form>
