					<div class="jrpg-nav-icon-box"><img src="systems/stryder/assets/stryderfvtt_title.png" /></div>
					<span>Character</span>
				</button>
<button type="button" class="jrpg-menu-btn" data-target="battle">
					<div class="jrpg-nav-icon-box"><img src="systems/stryder/assets/turn-start.svg" /></div>
					<span>Battle</span>
				</button>
				<button type="button" class="jrpg-menu-btn" data-target="exploration">
					<div class="jrpg-nav-icon-box"><img src="systems/stryder/assets/movement-speeds.svg" /></div>
					<span>Roleplay</span>
				</button>
<button type="button" class="jrpg-menu-btn" data-target="inventory">
					<div class="jrpg-nav-icon-box"><img src="systems/stryder/assets/spring-of-life.svg" /></div>
					<span>Inventory</span>
				</button>
				<button type="button" class="jrpg-menu-btn" data-target="tempering">
