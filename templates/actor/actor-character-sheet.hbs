								<h3 class="jrpg-char-section-title csheet-stats-title">Stats</h3>
								<span class="jrpg-stat-pool-counter">
									<span class="jrpg-stat-pool-remaining">{{statPointRemaining}}</span>
									<span class="jrpg-stat-pool-sep">/</span>
									<span class="jrpg-stat-pool-total">{{statPointTotal}}</span>
									<span class="jrpg-stat-pool-label">&nbsp;pts</span>
								</span>
							</div>
							<div class="csheet-stats-hairline"></div>

							<div class="jrpg-stat-row">
