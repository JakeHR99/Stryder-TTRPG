			</nav>
		</div>
		<div class="jrpg-center">
			<button type="button" class="jrpg-effects-btn" data-target="effects" title="Effects">
				<i class="fas fa-cog"></i>
			</button>
			<div class="jrpg-portrait-frame">
				<img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
			</div>
			<div class="jrpg-player-card-wrap">
				<div class="jrpg-player-card">
					<div class="jrpg-player-portrait-wrap">
						<div class="jrpg-player-portrait-diamond">
							<img src="{{actor.prototypeToken.texture.src}}" class="jrpg-player-portrait-img" data-edit="prototypeToken.texture.src" title="Set card portrait" />
						</div>
					</div>
					<div class="jrpg-player-info">
						<div class="jrpg-player-name">
							{{actor.name}}<span class="jrpg-player-level-sep"> · </span><span class="jrpg-player-level">Lv. {{system.attributes.level.value}}</span>
						</div>
						<div class="jrpg-player-class-folk">{{system.class.name}}{{#if system.folk.name}} · {{system.folk.name}}{{/if}}</div>
						<div class="jrpg-player-stat-row">
							<span class="jrpg-pstat-label hp-label">HP</span>
							<div class="jrpg-pstat-bar-track"><div class="jrpg-pstat-bar hp-pfill" style="width:{{hpPct}}%"></div></div>
							<span class="jrpg-pstat-values hp-label">{{system.health.value}}<span class="jrpg-pstat-sep">/</span>{{system.health.max}}</span>
						</div>
						<div class="jrpg-player-stat-row">
							<span class="jrpg-pstat-label mp-label">MP</span>
							<div class="jrpg-pstat-bar-track"><div class="jrpg-pstat-bar mp-pfill" style="width:{{mpPct}}%"></div></div>
							<span class="jrpg-pstat-values mp-label">{{system.mana.value}}<span class="jrpg-pstat-sep">/</span>{{system.mana.max}}</span>
						</div>
						<div class="jrpg-player-stat-row">
							<span class="jrpg-pstat-label sp-label">STA</span>
							<div class="jrpg-pstat-bar-track"><div class="jrpg-pstat-bar sp-pfill" style="width:{{staPct}}%"></div></div>
							<span class="jrpg-pstat-values sp-label">{{system.stamina.value}}<span class="jrpg-pstat-sep">/</span>{{system.stamina.max}}</span>
						</div>
					</div>
				</div>
				<div class="jrpg-recovery-buttons">
					<button type="button" class="jrpg-recovery-btn" data-action="springOfLife">Spring of Life</button>
					<button type="button" class="jrpg-recovery-btn" data-action="resting">Rest</button>
				</div>
			</div>
		</div>
	</div>

	<!-- ====== SCREEN 2: SUB-PAGES ====== -->
	<div class="jrpg-sub-screen" style="display:none;">
		<div class="jrpg-sub-bg">
			<div class="jrpg-sub-line"></div>
			<div class="jrpg-sub-line"></div>
			<div class="jrpg-sub-line"></div>
		</div>
		<div class="jrpg-sub-header">
			<button type="button" class="jrpg-back-btn">&#8592; Main Menu</button>
			<button type="button" class="jrpg-back-to-tempering-btn" style="display:none;">&#8592; Tempering</button>
			<span class="jrpg-sub-title"></span>
		</div>
		<div class="jrpg-sub-content">
			<div class="jrpg-page" data-page="character">
				<div class="jrpg-char-edit">

					<div class="jrpg-char-section">
						<h3 class="jrpg-char-section-title">Identity</h3>
						<div class="jrpg-char-field">
							<label class="jrpg-char-label">Name</label>
							<input type="text" name="name" value="{{actor.name}}" class="jrpg-char-input jrpg-char-input-wide" />
						</div>
						<div class="jrpg-char-field">
							<label class="jrpg-char-label">Level</label>
							<input type="number" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number" class="jrpg-char-input jrpg-char-input-small" />
						</div>
						<div class="jrpg-char-field">
							<label class="jrpg-char-label">Class</label>
							<select name="system.class.name" class="jrpg-char-select jrpg-class-select" data-dtype="String">
								<option value="" {{#unless system.class.name}}selected{{/unless}}>— Choose Class —</option>
								<option value="Warrior"  {{#if (eq system.class.name "Warrior")}}selected{{/if}}>Warrior</option>
								<option value="Ranger"   {{#if (eq system.class.name "Ranger")}}selected{{/if}}>Ranger</option>
								<option value="Warlock"  {{#if (eq system.class.name "Warlock")}}selected{{/if}}>Warlock</option>
								<option value="Shaman"   {{#if (eq system.class.name "Shaman")}}selected{{/if}}>Shaman</option>
								<option value="Summoner" {{#if (eq system.class.name "Summoner")}}selected{{/if}}>Summoner</option>
								<option value="Wytch"    {{#if (eq system.class.name "Wytch")}}selected{{/if}}>Wytch</option>
							</select>
						</div>
						<div class="jrpg-char-field">
							<label class="jrpg-char-label">Folk</label>
							<select class="jrpg-char-select jrpg-folk-select" name="system.folk.name" data-dtype="String">
								<option value="" {{#unless system.folk.name}}selected{{/unless}}>— Select Folk —</option>
								<option value="Feyfolk"     {{#if (eq system.folk.name "Feyfolk")}}selected{{/if}}>Feyfolk</option>
								<option value="Remnant"     {{#if (eq system.folk.name "Remnant")}}selected{{/if}}>Remnant</option>
								<option value="Sunborn"     {{#if (eq system.folk.name "Sunborn")}}selected{{/if}}>Sunborn</option>
								<option value="Oumen"       {{#if (eq system.folk.name "Oumen")}}selected{{/if}}>Oumen</option>
								<option value="Halfling"    {{#if (eq system.folk.name "Halfling")}}selected{{/if}}>Halfling</option>
								<option value="Smallfolk"   {{#if (eq system.folk.name "Smallfolk")}}selected{{/if}}>Smallfolk</option>
								<option value="Floran"      {{#if (eq system.folk.name "Floran")}}selected{{/if}}>Floran</option>
								<option value="Descendants" {{#if (eq system.folk.name "Descendants")}}selected{{/if}}>Descendants</option>
								<option value="Traveler"    {{#if (eq system.folk.name "Traveler")}}selected{{/if}}>Traveler</option>
								<option value="Colossus"    {{#if (eq system.folk.name "Colossus")}}selected{{/if}}>Colossus</option>
								<option value="Wildkin"     {{#if (eq system.folk.name "Wildkin")}}selected{{/if}}>Wildkin</option>
							</select>
						</div>
						{{#if folkDisplay.subfolks}}
						<div class="jrpg-char-field">
							<label class="jrpg-char-label">Subfolk</label>
							<select class="jrpg-char-select jrpg-subfolk-select" name="system.folk.subfolk" data-dtype="String">
								<option value="" {{#unless folkDisplay.currentSubfolk}}selected{{/unless}}>— Select Subfolk —</option>
								{{#each folkDisplay.subfolks}}
								<option value="{{this}}" {{#if (eq this ../folkDisplay.currentSubfolk)}}selected{{/if}}>{{this}}</option>
								{{/each}}
							</select>
						</div>
						{{/if}}
						{{#if folkDisplay}}
