<script>
	function updateSpiritBeastSheenClipping() {
		const hpBar = document.querySelector('.hp-bar');
		if (hpBar) {
			const hpFillPercent = (hpBar.value / hpBar.max) * 100;
			const hpSheenWrapper = document.querySelector('.hp-sheen-wrapper');
			if (hpSheenWrapper) {
				hpSheenWrapper.style.width = `${hpFillPercent}%`;
			}
		}
	}
	function initializeSpiritBeastSheenClipping() {
		let attempts = 0;
		const maxAttempts = 10;
		function tryUpdate() {
			attempts++;
			const hpBar = document.querySelector('.hp-bar');
			if (hpBar) {
				updateSpiritBeastSheenClipping();
			} else if (attempts < maxAttempts) {
				setTimeout(tryUpdate, 100);
			}
		}
		tryUpdate();
	}
	document.addEventListener('DOMContentLoaded', initializeSpiritBeastSheenClipping);
	document.addEventListener('renderActorSheet', function() {
		setTimeout(initializeSpiritBeastSheenClipping, 100);
	});
	document.addEventListener('change', function(e) {
		if (e.target.name && e.target.name.includes('health')) {
			setTimeout(updateSpiritBeastSheenClipping, 50);
		}
	});
	document.addEventListener('input', function(e) {
		if (e.target.name && e.target.name.includes('health')) {
			setTimeout(updateSpiritBeastSheenClipping, 50);
		}
	});
	setInterval(function() {
		const hpBar = document.querySelector('.hp-bar');
		if (hpBar) { updateSpiritBeastSheenClipping(); }
	}, 2000);
</script>

<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

<div class="unique-logo-container">
    <img class="logo" src="systems/stryder/assets/stryderfvtt_title.png" width="125" height="125">
</div>

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" style="margin-top: 50px;"/>
    <div class="header-fields">
      <div class="fantasy-input">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      </div><br />

      <div class="character-details-secondary textalign-center flexrow" style="margin-bottom: 20px;">
        <div class="character-weightclass">
          <label for="{{actor._id}}gate" class="resource-label-info">Gate</label>
          <div class="dropdown-field">
            <select class="secondary-input" name="system.gate" style="width: 100%; font-size: 16px; font-weight: normal;">
              {{selectOptions gateChoices selected=system.gate}}
            </select>
          </div>
        </div>
        <div class="character-weightclass">
          <label for="{{actor._id}}creature_size" class="resource-label-info">{{localize "Creature Size"}}</label>
          <div class="dropdown-field">
            <select class="secondary-input" name="system.attributes.creature_size" style="width: 100%; font-size: 16px; font-weight: normal;">
              {{selectOptions creatureSizeChoices selected=system.attributes.creature_size}}
            </select>
          </div>
        </div>
      </div>

      <div class="resources grid grid-2col" style="margin-left: 25px; width: 80%;">
        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label"><img style="width: 15px; height: 15px; border: 0px; position: relative; top: 15px; margin-right: -5px;" src="systems/stryder/assets/health-symbol.svg">Health</label>
          <div class="hpbar">
            <div class="hp-progress-bar">
              <progress class="hp-bar grid-span-3" value="{{system.health.value}}" max="{{system.health.max}}"></progress>
              <div class="hp-sheen-wrapper">
                <div class="hp-sheen"></div>
              </div>
            </div>
          </div>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
            <span> / </span>
            <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label class="resource-label"><img style="width: 20px; height: 20px; border: 0px; position: relative; top: 10px; margin-bottom: -5px;" src="systems/stryder/assets/run.svg">Running</label>
          <div class="resource-content flexrow flex-center flex-between" style="margin-top: 10px;">
            <input type="text" name="system.attributes.move.running.value" value="{{system.attributes.move.running.value}}" data-dtype="Number"/>
          </div>
        </div>
      </div>

    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="features">Abilities</a>
    <a class="item" data-tab="battle">Movement</a>
    <a class="item" data-tab="description">Notes</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Abilities Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      {{> "systems/stryder/templates/actor/parts/spirit-beast-features.hbs"}}
    </div>

    {{!-- Movement Tab --}}
    <div class="tab battle" data-group="primary" data-tab="battle">
      {{> "systems/stryder/templates/actor/parts/spirit-beast-battle.hbs"}}
    </div>

    {{!-- Notes Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      <div class="editor-container biography">
        <h2 class="section-header" style="border-bottom: 0px;"><strong>Notes</strong></h2>
        {{editor system.biography target="system.biography" rollData=rollData button=true owner=owner editable=editable}}
      </div>
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/stryder/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>

{{log system}}
